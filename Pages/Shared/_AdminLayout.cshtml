@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EduBridge.Services.Auth.ICurrentCenterService CurrentCenterService
@inject EduBridge.Services.Auth.IAccountAuthenticationService AuthService
@inject EduBridge.Data.AppDbContext DbContext
@{
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? "Người dùng";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var initials = string.Join(
        string.Empty,
        fullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .TakeLast(2)
            .Select(part => part[0]))
        .ToUpperInvariant();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "U";
    }

    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var availableRoles = new List<string>();
    if (int.TryParse(userIdStr, out int layoutUserId))
    {
        availableRoles = await AuthService.GetAvailableRolesAsync(layoutUserId);
    }
    var hasTeacherRole = availableRoles.Contains("TEACHER");

    var currentRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var isSystemAdmin = currentRole == "SYSTEM_ADMIN";
    var isOwner = currentRole == "OWNER";
    
    var supportCenterIdStr = Context.Request.Cookies["SupportCenterId"];
    var isSupportMode = isSystemAdmin && !string.IsNullOrEmpty(supportCenterIdStr);
    
    var showCenterMenu = isOwner || isSupportMode;

    // Lấy danh sách Branches
    var currentCenterId = await CurrentCenterService.GetCenterIdAsync();
    var branches = new List<EduBridge.Models.Branch>();
    if (currentCenterId.HasValue)
    {
        branches = await DbContext.Branches
            .AsNoTracking()
            .Where(b => b.CenterId == currentCenterId.Value && b.Status == "ACTIVE")
            .OrderBy(b => b.BranchName)
            .ToListAsync();
    }
    
    var currentBranchIdStr = Context.Request.Cookies["CurrentBranchId"];
    int.TryParse(currentBranchIdStr, out int currentBranchId);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduBridge Admin Panel</title>
    @await RenderSectionAsync("Styles", required: false)
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f3f4; font-size: 14px; }

        /* Body internal styles - DO NOT MODIFY */
        .admin-main { padding: 1.25rem; }
        .admin-main h1 { font-size: 1.625rem; line-height: 2rem; }
        .admin-main h1 + p { font-size: 0.875rem; }
        .admin-main .rounded-2xl { border-radius: 0.75rem; }
        .admin-main .bg-blue-50\/60.p-6 { padding: 1.25rem; }
        .admin-main input:not([type="hidden"]):not([type="radio"]):not([type="checkbox"]):not([type="file"]),
        .admin-main select, .admin-main [data-dropdown-toggle], .admin-main [data-range-toggle] {
            min-height: 2.5rem !important; height: 2.5rem !important; font-size: 0.8125rem !important;
            padding-left: 0.875rem !important; padding-right: 0.875rem !important;
        }
        .admin-main [data-range-toggle] span:last-child { width: 2.75rem !important; }
        .admin-main [data-range-toggle] { padding-left: 0 !important; padding-right: 0 !important; }
        .admin-main [data-dropdown-search] { height: 2.375rem !important; }
        .admin-main a.inline-flex:not(.h-11):not(.h-12), .admin-main button.inline-flex:not(.h-11):not(.h-12) { font-size: 0.8125rem; }
        .admin-main a.h-11, .admin-main button.h-11, .admin-main a.h-12, .admin-main button.h-12 {
            height: 2.5rem !important; min-height: 2.5rem !important; font-size: 0.8125rem !important;
        }
        .admin-main table thead tr { font-size: 0.8125rem !important; }
        .admin-main table th, .admin-main table td { padding: 0.75rem 0.875rem !important; font-size: 0.8125rem !important; }
        .admin-main table .h-10.w-10, .admin-main table .w-10.h-10 { width: 2rem !important; height: 2rem !important; margin-right: 0.75rem !important; }
        .admin-main table .h-11.w-11, .admin-main table .w-11.h-11 { width: 2.375rem !important; height: 2.375rem !important; }
        .admin-main table .h-5.w-5, .admin-main table .w-5.h-5 { width: 1.125rem !important; height: 1.125rem !important; }
        .admin-main table .gap-3 { gap: 0.5rem !important; }
        .admin-main table .min-w-28 { min-width: 5.75rem !important; }
        .admin-main .border-t.bg-white.px-6.py-4 { padding: 0.75rem 1rem !important; }
        /* End Body internal styles */

        /* Custom Scrollbar for sidebar */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #4b5d6d; border-radius: 4px; }
        .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: #6c7c8b; }

        /* Menu active state based on image: slightly darker bg, left border blue/green */
        .admin-sidebar-link.active {
            background-color: #293846;
            color: #ffffff;
            border-left: 4px solid #19aa8d; /* green brand color */
        }
        .admin-sidebar-link {
            border-left: 4px solid transparent;
            color: #a7b1c2;
        }
        .admin-sidebar-link:hover {
            background-color: #293846;
            color: #ffffff;
        }

        /* Basic Collapse styles for phase 2 - not fully animated yet but functional */
        body.admin-sidebar-collapsed #admin-sidebar { width: 4.5rem !important; }
        body.admin-sidebar-collapsed #header-logo-area { width: 4.5rem !important; }
        body.admin-sidebar-collapsed .admin-header-brand-text { display: none; }
        body.admin-sidebar-collapsed .admin-header-brand-icon { display: block; }
        body.admin-sidebar-collapsed .admin-sidebar-user-info { display: none; }
        body.admin-sidebar-collapsed .admin-sidebar-user-section { padding-left: 0.75rem; padding-right: 0.75rem; justify-content: center; }
        body.admin-sidebar-collapsed .admin-sidebar-user-section .w-12 { width: 2.5rem; height: 2.5rem; font-size: 1rem; }
        body.admin-sidebar-collapsed .admin-sidebar-branch-section { display: none; }
        body.admin-sidebar-collapsed .admin-sidebar-label { display: none; }
        body.admin-sidebar-collapsed .admin-sidebar-link { padding-left: 0.75rem; padding-right: 0.75rem; justify-content: center; border-left: none; }
        body.admin-sidebar-collapsed .admin-sidebar-link.active { border-left: none; background-color: #293846; }
        body.admin-sidebar-collapsed .admin-sidebar-link svg { margin-right: 0; }
    </style>
</head>
<body class="text-gray-800 flex flex-col h-screen overflow-hidden bg-[#f3f3f4]">
    <div id="layout-toast-container" class="fixed right-6 top-20 z-50 flex w-[380px] max-w-[calc(100vw-2rem)] flex-col gap-3"></div>

    <!-- Header -->
    <header class="h-14 bg-[#3c8dbc] flex items-center justify-between z-20 flex-shrink-0 shadow-sm relative">
        <!-- Logo Area -->
        <div id="header-logo-area" class="h-full bg-[#367fa9] flex items-center justify-center w-64 flex-shrink-0 text-white transition-all duration-200">
            <span class="font-bold text-xl tracking-wide admin-header-brand-text">EDUBRIDGE</span>
            <span class="font-bold text-xl hidden admin-header-brand-icon">EB</span>
        </div>
        
        <!-- Top Nav -->
        <div class="flex-1 flex justify-between items-center px-4 h-full bg-[#3c8dbc]">
            <!-- Hamburger -->
            <button id="admin-sidebar-toggle" class="hover:bg-[#367fa9] p-2 rounded text-white transition-colors" aria-label="Thu gọn/mở rộng sidebar" aria-expanded="true">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
            
            <!-- Right side -->
            <div class="flex items-center space-x-3 text-white h-full">
                <!-- Notification (Temporarily Hidden) -->
                <div class="relative h-full flex items-center hidden">
                    <button id="headerNotificationBtn" class="hover:bg-[#367fa9] p-2 rounded relative transition-colors h-10 w-10 flex items-center justify-center" aria-label="Thông báo" aria-expanded="false">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                        <span id="headerNotificationBadge" class="absolute top-1 right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[16px] text-center hidden">0</span>
                    </button>
                    <!-- Notification Dropdown -->
                    <div id="headerNotificationMenu" class="hidden absolute right-0 top-14 w-80 bg-white rounded-md shadow-lg border border-gray-200 z-50 overflow-hidden flex flex-col">
                        <div class="px-4 py-3 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                            <p class="text-sm font-semibold text-gray-800">Thông báo</p>
                            <button id="headerNotificationMarkAllBtn" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Đánh dấu đã đọc</button>
                        </div>
                        <div id="headerNotificationList" class="max-h-80 overflow-y-auto custom-scrollbar flex-1 bg-white">
                            <!-- JS will populate notifications here -->
                            <div class="p-4 text-center text-sm text-gray-500">Đang tải...</div>
                        </div>
                        <div class="px-4 py-2 border-t border-gray-100 text-center bg-gray-50">
                            <a href="#" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Xem tất cả thông báo</a>
                        </div>
                    </div>
                </div>
                
                <!-- User Menu -->
                <div class="relative h-full flex items-center">
                    <button id="headerUserBtn" class="flex items-center space-x-2 hover:bg-[#367fa9] px-3 py-1.5 rounded transition-colors h-10" aria-expanded="false">
                        <div class="w-7 h-7 rounded-full bg-white text-[#3c8dbc] flex items-center justify-center font-bold text-xs flex-shrink-0">
                            @initials
                        </div>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <!-- User Dropdown Menu -->
                    <div id="headerUserMenu" class="hidden absolute right-0 top-14 w-48 bg-white rounded-md shadow-lg py-1 text-gray-700 border border-gray-200 z-50">
                        <div class="px-4 py-2 border-b border-gray-100">
                            <p class="text-sm font-semibold">Quản lý tài khoản</p>
                        </div>
                        @if (hasTeacherRole)
                        {
                            <form method="post" asp-page="/SwitchRole" class="w-full m-0">
                                <input type="hidden" name="roleCode" value="TEACHER" />
                                <button type="submit" class="flex items-center w-full px-4 py-2 text-sm hover:bg-gray-100 text-left">
                                    <svg class="w-4 h-4 mr-2 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
                                    Giao diện Giáo viên
                                </button>
                            </form>
                        }
                        <a href="/Profile" class="flex items-center px-4 py-2 text-sm hover:bg-gray-100">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            Thông tin
                        </a>
                        <a href="/ChangePassword" class="flex items-center px-4 py-2 text-sm hover:bg-gray-100">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            Đổi mật khẩu
                        </a>
                        <div class="border-t border-gray-100 my-1"></div>
                        <form method="post" asp-page="/Logout" class="w-full m-0">
                            <button type="submit" class="flex items-center w-full px-4 py-2 text-sm hover:bg-gray-100 text-left text-red-600">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Sidebar and Main Wrapper -->
    <div class="flex flex-1 overflow-hidden relative">
        <!-- Sidebar -->
        <aside id="admin-sidebar" class="w-64 bg-[#2f4050] text-[#a7b1c2] flex-shrink-0 flex flex-col transition-all duration-200 z-10 custom-scrollbar">
            <!-- User Info area -->
            <div class="p-4 border-b border-[#374c5e] flex items-center space-x-3 admin-sidebar-user-section flex-shrink-0">
                <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-lg flex-shrink-0">
                    @initials
                </div>
                <div class="min-w-0 flex-1 admin-sidebar-user-info">
                    <div class="text-white font-semibold text-sm truncate" title="@fullName">@fullName</div>
                    <div class="text-xs flex items-center mt-0.5">
                        <span class="w-2.5 h-2.5 bg-green-500 rounded-full mr-1.5 shadow-[0_0_4px_rgba(34,197,94,0.6)]"></span>
                        Trực tuyến
                    </div>
                </div>
            </div>

            <!-- Branch selector -->
            @if (showCenterMenu && branches.Any())
            {
                <div class="p-4 border-b border-[#374c5e] admin-sidebar-branch-section flex-shrink-0">
                    <div class="text-white font-semibold mb-2 flex items-center justify-center admin-sidebar-branch-label">Dự án quản lý</div>
                    <form method="post" asp-page="/SetBranch" class="m-0">
                        <div class="relative">
                            <select name="branchId" onchange="this.form.submit()" class="w-full bg-white text-gray-800 text-sm rounded h-9 pl-3 pr-8 appearance-none focus:outline-none focus:ring-2 focus:ring-[#1ab394] shadow-sm cursor-pointer truncate">
                                <option value="0">Tất cả dự án</option>
                                @foreach (var branch in branches)
                                {
                                    if (currentBranchId == branch.BranchId)
                                    {
                                        <option value="@branch.BranchId" selected>@branch.BranchName</option>
                                    }
                                    else
                                    {
                                        <option value="@branch.BranchId">@branch.BranchName</option>
                                    }
                                }
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </div>
                    </form>
                </div>
            }

            <!-- Navigation -->
            <nav class="flex-1 overflow-y-auto custom-scrollbar py-2 admin-sidebar-nav text-[13px] font-medium">
                @if (isSystemAdmin && !isSupportMode)
                {
                    var statusCodeFeature = Context.Features.Get<Microsoft.AspNetCore.Diagnostics.IStatusCodeReExecuteFeature>();
                    var currentPath = statusCodeFeature?.OriginalPath ?? Context.Request.Path.Value ?? "";
                    
                    var isCentersActive = ViewData["ActivePage"] as string == "SystemCenters" || (ViewData["ActivePage"] == null && (currentPath.StartsWith("/SystemAdmin/Centers", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/SystemAdmin", StringComparison.OrdinalIgnoreCase) || currentPath == "/"));
                    var isStaffsActive = ViewData["ActivePage"] as string == "SystemStaffs" || (ViewData["ActivePage"] == null && currentPath.StartsWith("/SystemAdmin/Staffs", StringComparison.OrdinalIgnoreCase));
                    var isAuditLogsActive = ViewData["ActivePage"] as string == "SystemAuditLogs" || (ViewData["ActivePage"] == null && currentPath.StartsWith("/SystemAdmin/AuditLogs", StringComparison.OrdinalIgnoreCase));

                    <a href="/SystemAdmin/Centers" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isCentersActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        <span class="admin-sidebar-label truncate">Trung tâm</span>
                    </a>
                    <a href="/SystemAdmin/Staffs" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isStaffsActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="admin-sidebar-label truncate">Nhân sự</span>
                    </a>
                    <a href="/SystemAdmin/AuditLogs" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isAuditLogsActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span class="admin-sidebar-label truncate">Nhật ký hệ thống</span>
                    </a>
                }
                
                @if (showCenterMenu)
                {
                    var isDashboardActive = ViewData["ActivePage"] as string == "AdminDashboard" || ViewData["ActivePage"] == null;
                    var isClassesActive = ViewData["ActivePage"] as string == "AdminClasses";
                    var isCoursesActive = ViewData["ActivePage"] as string == "AdminCourses";
                    var isStudentsActive = ViewData["ActivePage"] as string == "AdminStudents";
                    var isParentsActive = ViewData["ActivePage"] as string == "AdminParents";
                    var isStaffActive = ViewData["ActivePage"] as string == "AdminStaff";
                    var isFinanceActive = ViewData["ActivePage"] as string == "AdminFinance";
                    var isSettingsActive = ViewData["ActivePage"] as string == "AdminSettings";

                    <a href="/AdminDashboard" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isDashboardActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span class="admin-sidebar-label truncate">Dashboard</span>
                    </a>
                    <a href="/AdminClasses" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isClassesActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        <span class="admin-sidebar-label truncate">Lớp học</span>
                    </a>
                    <a href="/AdminCourses" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isCoursesActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path><path d="M8 6h8"></path><path d="M8 10h6"></path></svg>
                        <span class="admin-sidebar-label truncate">Môn học</span>
                    </a>
                    <a href="/AdminStudents" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isStudentsActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span class="admin-sidebar-label truncate">Học sinh</span>
                    </a>
                    <a href="/AdminParents" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isParentsActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"></circle><path d="M5.5 21a6.5 6.5 0 0 1 13 0"></path><path d="M19 8.5a3 3 0 0 1 0 5"></path><path d="M21.5 21a5 5 0 0 0-3.5-4.77"></path></svg>
                        <span class="admin-sidebar-label truncate">Phụ huynh</span>
                    </a>
                    <a href="/AdminStaff" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isStaffActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                        <span class="admin-sidebar-label truncate">Nhân sự</span>
                    </a>
                    <a href="/AdminFinance" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isFinanceActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        <span class="admin-sidebar-label truncate">Tài chính</span>
                    </a>
                    <a href="/AdminSettings" class="admin-sidebar-link flex items-center px-5 py-3 transition-colors @(isSettingsActive ? "active" : "")">
                        <svg class="w-[18px] h-[18px] mr-3 opacity-80 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        <span class="admin-sidebar-label truncate">Cài đặt</span>
                    </a>
                }
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="admin-main flex-1 overflow-y-auto relative bg-[#f3f3f4]">
            @if (isSupportMode)
            {
                <div class="bg-red-50 text-red-700 border border-red-200 px-4 py-3 rounded-xl mb-4 flex justify-between items-center shadow-sm">
                    <div class="font-medium flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        Bạn đang trong chế độ Hỗ Trợ (Support Mode). Mọi thao tác sẽ được ghi lại.
                    </div>
                    <form method="post" asp-page="/SystemAdmin/ExitSupportMode" class="m-0">
                        <button type="submit" class="bg-white text-red-600 px-3 py-1.5 rounded-lg border border-red-200 text-sm font-bold hover:bg-red-50 transition-colors">
                            Thoát chế độ hỗ trợ
                        </button>
                    </form>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const adminSidebarStorageKey = 'edubridge.admin.sidebar.collapsed';
        const adminSidebarToggle = document.getElementById('admin-sidebar-toggle');

        function setAdminSidebarCollapsed(isCollapsed) {
            document.body.classList.toggle('admin-sidebar-collapsed', isCollapsed);
            if (adminSidebarToggle) {
                adminSidebarToggle.setAttribute('aria-expanded', (!isCollapsed).toString());
            }
            localStorage.setItem(adminSidebarStorageKey, isCollapsed ? 'true' : 'false');
        }

        setAdminSidebarCollapsed(localStorage.getItem(adminSidebarStorageKey) === 'true');
        if (adminSidebarToggle) {
            adminSidebarToggle.addEventListener('click', () => {
                setAdminSidebarCollapsed(!document.body.classList.contains('admin-sidebar-collapsed'));
            });
        }

        const headerUserBtn = document.getElementById('headerUserBtn');
        const headerUserMenu = document.getElementById('headerUserMenu');
        
        if (headerUserBtn && headerUserMenu) {
            headerUserBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = headerUserMenu.classList.contains('hidden');
                
                const notifMenu = document.getElementById('headerNotificationMenu');
                if (notifMenu && !notifMenu.classList.contains('hidden')) {
                    notifMenu.classList.add('hidden');
                    document.getElementById('headerNotificationBtn')?.setAttribute('aria-expanded', 'false');
                }

                headerUserMenu.classList.toggle('hidden');
                headerUserBtn.setAttribute('aria-expanded', !headerUserMenu.classList.contains('hidden'));
            });
            
            document.addEventListener('click', (e) => {
                if (!headerUserMenu.contains(e.target) && !headerUserBtn.contains(e.target)) {
                    headerUserMenu.classList.add('hidden');
                    headerUserBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        const layoutToastStorageKey = 'edubridge.admin.toasts';

        function getStoredLayoutToasts() {
            try {
                const value = localStorage.getItem(layoutToastStorageKey);
                const toasts = value ? JSON.parse(value) : [];
                const now = Date.now();

                return Array.isArray(toasts)
                    ? toasts.filter(toast => toast && toast.expiresAt > now)
                    : [];
            } catch {
                return [];
            }
        }

        function saveStoredLayoutToasts(toasts) {
            localStorage.setItem(layoutToastStorageKey, JSON.stringify(toasts));
        }

        function removeStoredLayoutToast(id) {
            saveStoredLayoutToasts(getStoredLayoutToasts().filter(toast => toast.id !== id));
        }

        function pushStoredLayoutToast(title, message, type) {
            if (!message) {
                return;
            }

            const toasts = getStoredLayoutToasts();
            toasts.push({
                id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
                title,
                message,
                type,
                expiresAt: Date.now() + 4500
            });

            saveStoredLayoutToasts(toasts);
        }

        function showLayoutToast(title, message, type, id, remainingMs) {
            if (!message) {
                return;
            }

            const container = document.getElementById('layout-toast-container');
            const isError = type === 'error' || type === 'danger' || type === 'failed';
            const toast = document.createElement('div');
            const colorClasses = isError
                ? 'border-red-300 bg-red-100 text-red-900'
                : 'border-green-300 bg-green-100 text-green-900';
            const iconColor = isError ? 'text-red-700' : 'text-green-700';

            toast.className = `${colorClasses} pointer-events-auto flex translate-x-5 gap-3 rounded border-l-4 px-4 py-4 opacity-0 shadow-xl transition-all duration-300`;
            toast.innerHTML = `
                <div class="${iconColor} mt-0.5 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-white/60">
                    ${isError
                        ? '<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M6 18L18 6M6 6l12 12"></path></svg>'
                        : '<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"></path></svg>'}
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-base font-bold leading-5">${title || (isError ? 'Thất bại' : 'Thành công')}</div>
                    <div class="mt-1 text-sm font-medium leading-5">${message}</div>
                </div>
                <button type="button" class="${iconColor} -mr-1 -mt-1 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded hover:bg-white/60" aria-label="Đóng thông báo">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;

            const closeToast = () => {
                toast.classList.add('translate-x-5', 'opacity-0');
                if (id) {
                    removeStoredLayoutToast(id);
                }
                setTimeout(() => toast.remove(), 300);
            };

            toast.querySelector('button')?.addEventListener('click', closeToast);
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-5', 'opacity-0');
            });

            setTimeout(closeToast, Math.max(1200, remainingMs ?? 4500));
        }

        window.showToast = function(message, isSuccess = true) {
            const type = isSuccess ? 'success' : 'error';
            const title = isSuccess ? 'Thành công' : 'Thất bại';
            showLayoutToast(title, message, type, null, 4500);
        };

        // Notifications Logic
        const headerNotificationBtn = document.getElementById('headerNotificationBtn');
        const headerNotificationMenu = document.getElementById('headerNotificationMenu');
        const headerNotificationBadge = document.getElementById('headerNotificationBadge');
        const headerNotificationList = document.getElementById('headerNotificationList');
        const headerNotificationMarkAllBtn = document.getElementById('headerNotificationMarkAllBtn');

        function fetchUnreadCount() {
            fetch('/api/v1/shared/notifications/unread-count')
                .then(res => res.json())
                .then(data => {
                    if (data.success && headerNotificationBadge) {
                        const count = data.data;
                        if (count > 0) {
                            headerNotificationBadge.textContent = count > 99 ? '99+' : count;
                            headerNotificationBadge.classList.remove('hidden');
                        } else {
                            headerNotificationBadge.classList.add('hidden');
                        }
                    }
                }).catch(err => console.error(err));
        }

        function fetchNotifications() {
            if (headerNotificationList) {
                headerNotificationList.innerHTML = '<div class="p-4 text-center text-sm text-gray-500">Đang tải...</div>';
            }
            fetch('/api/v1/shared/notifications/my?limit=10')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.data && headerNotificationList) {
                        renderNotifications(data.data);
                    }
                }).catch(err => {
                    console.error(err);
                    if (headerNotificationList) {
                        headerNotificationList.innerHTML = '<div class="p-4 text-center text-sm text-red-500">Lỗi khi tải thông báo.</div>';
                    }
                });
        }

        function renderNotifications(notifications) {
            if (notifications.length === 0) {
                headerNotificationList.innerHTML = '<div class="p-4 text-center text-sm text-gray-500">Không có thông báo nào.</div>';
                return;
            }
            
            headerNotificationList.innerHTML = notifications.map(n => `
                <div class="px-4 py-3 border-b border-gray-50 hover:bg-gray-50 cursor-pointer transition-colors ${!n.isRead ? 'bg-blue-50/30' : ''}" onclick="markNotificationAsRead(${n.notificationId})">
                    <div class="flex justify-between items-start mb-1">
                        <p class="text-sm font-semibold text-gray-800 ${!n.isRead ? 'text-blue-700' : ''}">${n.title}</p>
                        ${!n.isRead ? '<span class="w-2 h-2 bg-blue-600 rounded-full mt-1.5 flex-shrink-0"></span>' : ''}
                    </div>
                    <p class="text-xs text-gray-600 line-clamp-2 mb-1">${n.content}</p>
                    <p class="text-[10px] text-gray-400">${n.createdAtString}</p>
                </div>
            `).join('');
        }

        window.markNotificationAsRead = function(id) {
            fetch(`/api/v1/shared/notifications/${id}/read`, { method: 'PUT' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        fetchUnreadCount();
                        fetchNotifications();
                    }
                }).catch(err => console.error(err));
        }

        if (headerNotificationMarkAllBtn) {
            headerNotificationMarkAllBtn.addEventListener('click', () => {
                fetch('/api/v1/shared/notifications/read-all', { method: 'PUT' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            fetchUnreadCount();
                            fetchNotifications();
                        }
                    }).catch(err => console.error(err));
            });
        }

        if (headerNotificationBtn && headerNotificationMenu) {
            fetchUnreadCount();

            headerNotificationBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = headerNotificationMenu.classList.contains('hidden');
                
                if (headerUserMenu && !headerUserMenu.classList.contains('hidden')) {
                    headerUserMenu.classList.add('hidden');
                    headerUserBtn.setAttribute('aria-expanded', 'false');
                }

                if (isHidden) {
                    headerNotificationMenu.classList.remove('hidden');
                    headerNotificationBtn.setAttribute('aria-expanded', 'true');
                    fetchNotifications();
                } else {
                    headerNotificationMenu.classList.add('hidden');
                    headerNotificationBtn.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('click', (e) => {
                if (!headerNotificationMenu.contains(e.target) && !headerNotificationBtn.contains(e.target)) {
                    headerNotificationMenu.classList.add('hidden');
                    headerNotificationBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        pushStoredLayoutToast(
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastTitle"] as string)),
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"] as string)),
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastType"] as string))
        );

        getStoredLayoutToasts().forEach(toast => {
            showLayoutToast(
                toast.title,
                toast.message,
                toast.type,
                toast.id,
                toast.expiresAt - Date.now()
            );
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
