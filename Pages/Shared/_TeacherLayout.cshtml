        }

        .owner-shell {
            background: #f5f7f9;
            color: #2f3f4d;
            display: flex;
            flex-direction: column;
        }

        .owner-topbar {
            height: 52px;
            flex-shrink: 0;
            background: #3f96c4;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.18);
            z-index: 30;
        }

        .owner-topbar-brand {
            display: flex;
            align-items: center;
            gap: 46px;
            min-width: 0;
        }

        .owner-topbar-title {
            font-size: 19px;
            font-weight: 800;
            letter-spacing: 0;
            line-height: 1;
            white-space: nowrap;
        }

        .owner-topbar-toggle {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: #fff;
            transition: background-color .15s ease;
        }

        .owner-topbar-toggle:hover {
            background: rgba(255,255,255,.12);
        }

        .owner-topbar-actions {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .owner-profile-menu-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
        }

        .owner-icon-btn {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            background: transparent;
            color: #fff;
            border-radius: 50%;
        }

        .owner-topbar-avatar {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            border: 4px solid rgba(255,255,255,.65);
            background: #edf6ff;
            color: #2c4662;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            transition: transform .15s ease, border-color .15s ease;
        }

        .owner-topbar-avatar:hover {
            transform: translateY(-1px);
            border-color: rgba(255,255,255,.9);
        }

        .owner-profile-menu {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 240px;
            z-index: 60;
        }

        .owner-profile-menu-panel {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, .18);
            padding: 8px;
        }

        .owner-profile-menu::before {
            content: "";
            position: absolute;
            top: -6px;
            right: 14px;
            width: 12px;
            height: 12px;
            background: #fff;
            border-left: 1px solid #e5e7eb;
            border-top: 1px solid #e5e7eb;
            transform: rotate(45deg);
        }

        .owner-workspace {
            display: flex;
            min-height: 0;
            flex: 1;
            overflow: hidden;
        }

        #admin-sidebar {
            width: 270px !important;
            background: #1d2c33 !important;
            border-right: 0 !important;
            color: #fff;
            justify-content: flex-start !important;
            overflow-y: auto;
            box-shadow: 4px 0 14px rgba(15, 23, 42, .12);
        }

        #admin-sidebar .admin-sidebar-logo-row {
            display: none !important;
        }

        #admin-sidebar > div:first-child {
            display: flex;
            min-height: 0;
            flex: 1;
            flex-direction: column;
        }

        .owner-sidebar-profile {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 30px 26px 22px;
        }

        .owner-sidebar-profile .owner-avatar {
            width: 48px;
            height: 48px;
            border-radius: 999px;
            border: 4px solid #d8efff;
            background: #f3f8fc;
            color: #2b4050;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            flex-shrink: 0;
        }

        .owner-profile-name {
            max-width: 160px;
            font-size: 15px;
            line-height: 1.25;
            font-weight: 800;
            color: #fff;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .owner-profile-status {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 4px;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
        }

        .owner-profile-status::before {
            content: "";
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #21c66f;
            box-shadow: 0 0 0 2px rgba(33,198,111,.18);
        }

        .owner-sidebar-section {
            padding: 8px 11px 20px;
            position: relative;
            z-index: 25;
        }

        .owner-sidebar-label {
            margin: 8px 0 8px;
            text-align: center;
            color: #fff;
            font-weight: 800;
            font-size: 15px;
        }

        #admin-sidebar .admin-sidebar-nav {
            position: relative;
            z-index: 1;
            margin-top: 0 !important;
            padding: 0 0 24px !important;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        #admin-sidebar .admin-sidebar-link {
            min-height: 45px;
            border-radius: 0 !important;
            color: #fff !important;
            padding: 0 16px !important;
            font-weight: 800 !important;
            background: transparent !important;
        }

        #admin-sidebar .admin-sidebar-item {
            display: flex;
            flex-direction: column;
        }

        #admin-sidebar .admin-sidebar-link:hover {
            background: rgba(255,255,255,.08) !important;
            color: #fff !important;
        }

        #admin-sidebar .admin-sidebar-link.bg-blue-50,
        #admin-sidebar .admin-sidebar-link.text-blue-600 {
            background: transparent !important;
            color: #fff !important;
        }

        #admin-sidebar .admin-sidebar-link svg {
            color: #fff;
            width: 18px !important;
            height: 18px !important;
            margin-right: 8px !important;
            flex-shrink: 0;
        }

        #admin-sidebar .admin-sidebar-label {
            color: inherit;
            font-size: 15px;
            line-height: 1.2;
        }

        #admin-sidebar .admin-sidebar-link::after {
            content: "⌄";
            margin-left: auto;
            color: rgba(255,255,255,.92);
            font-size: 17px;
            line-height: 1;
            transition: transform .15s ease;
        }

        #admin-sidebar .admin-sidebar-link.bg-blue-50::after,
        #admin-sidebar .admin-sidebar-link.text-blue-600::after {
            content: "⌃";
        }

        #admin-sidebar .admin-sidebar-link.bg-blue-50:hover,
        #admin-sidebar .admin-sidebar-link.text-blue-600:hover {
            background: rgba(255,255,255,.08) !important;
        }

        #admin-sidebar .admin-sidebar-item.is-open > .admin-sidebar-link::after {
            content: "⌃";
        }

        #admin-sidebar .admin-sidebar-submenu {
            display: none;
            flex-direction: column;
            gap: 2px;
            padding: 4px 0 7px;
        }

        #admin-sidebar .admin-sidebar-item.is-open > .admin-sidebar-submenu {
            display: flex;
        }

        #admin-sidebar .admin-sidebar-submenu-link {
            min-height: 37px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 16px 0 31px;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
        }

        #admin-sidebar .admin-sidebar-submenu-link::before {
            content: "›";
            font-size: 18px;
            line-height: 1;
        }

        #admin-sidebar .admin-sidebar-submenu-link:hover,
        #admin-sidebar .admin-sidebar-submenu-link.is-active {
            background: #4298c7;
            color: #fff;
        }

        body.admin-sidebar-collapsed #admin-sidebar {
            width: 5rem !important;
        }

        body.admin-sidebar-collapsed #admin-sidebar .owner-sidebar-profile,
        body.admin-sidebar-collapsed #admin-sidebar .owner-sidebar-section {
            display: none !important;
        }

        body.admin-sidebar-collapsed #admin-sidebar .admin-sidebar-link::after {
            display: none;
        }

        body.admin-sidebar-collapsed #admin-sidebar .admin-sidebar-submenu {
            display: none !important;
        }

        #admin-sidebar .admin-sidebar-profile {
            color: #fff;
        }

        #admin-sidebar .admin-sidebar-avatar {
            background: #e8f5ff !important;
            color: #2e485e !important;
            border: 3px solid #cdeaff;
        }

        #admin-sidebar .admin-sidebar-user-info div:first-child {
            color: #fff !important;
        }

        #admin-sidebar .admin-sidebar-user-info div:last-child {
            color: rgba(255,255,255,.7) !important;
        }

        .admin-main {
            background: #f5f7f9;
            flex: 1;
            min-width: 0;
        }

        @@media (max-width: 768px) {
            .owner-topbar {
                padding: 0 16px;
            }

            .owner-topbar-brand {
                gap: 18px;
            }

            .owner-topbar-title {
                font-size: 17px;
            }

            #admin-sidebar {
                width: 240px !important;
            }
        }
    </style>
</head>
<body class="text-gray-800 h-screen overflow-hidden owner-shell">
    <div id="layout-toast-container" class="fixed right-6 top-6 z-50 flex w-[380px] max-w-[calc(100vw-2rem)] flex-col gap-3"></div>

    <header class="owner-topbar">
        <div class="owner-topbar-brand">
            <div class="owner-topbar-title">EDUBRIDGE</div>
            <button id="admin-sidebar-toggle" type="button" class="owner-topbar-toggle" aria-label="Thu gọn/mở rộng sidebar" aria-expanded="true">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 7h16M4 12h16M4 17h16"></path>
                </svg>
            </button>
        </div>
        <div class="owner-topbar-actions">
            <button type="button" class="owner-icon-btn" aria-label="Thông báo">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 21h4"></path>
                </svg>
            </button>
            <div class="owner-profile-menu-wrap">
                <button type="button" id="adminProfileBtn" class="owner-topbar-avatar" aria-label="Tài khoản" aria-expanded="false">@initials</button>
                <div id="adminProfileMenu" class="owner-profile-menu hidden">
                    <div class="owner-profile-menu-panel space-y-1">
                        @if (hasOwnerRole)
                        {
                            <form method="post" asp-page="/SwitchRole" class="w-full m-0">
                                <input type="hidden" name="roleCode" value="OWNER" />
                                <button type="submit" class="flex items-center w-full py-2 px-3 rounded-lg text-sm font-medium text-blue-700 hover:bg-blue-50 transition-colors text-left">
                                    <svg class="w-4 h-4 mr-3 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
                                    <span>Giao diện Quản lý</span>
                                </button>
                            </form>
                        }
                        <a href="/Profile" class="flex items-center w-full py-2 px-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                            <svg class="w-4 h-4 mr-3 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            <span>Hồ sơ cá nhân</span>
                        </a>
                        <a href="/ChangePassword" class="flex items-center w-full py-2 px-3 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                            <svg class="w-4 h-4 mr-3 text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            <span>Đổi mật khẩu</span>
                        </a>
                        <form method="post" asp-page="/Logout" class="w-full m-0">
                            <button type="submit" class="flex items-center w-full py-2 px-3 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors text-left">
                                <svg class="w-4 h-4 mr-3 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                <span>Đăng xuất</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="owner-workspace">

    <!-- Sidebar -->
    <aside id="admin-sidebar" class="w-64 bg-white border-r border-gray-200 flex flex-col justify-between flex-shrink-0">
        <div>
            <!-- Logo (Hidden in desktop by CSS, but used for collapsed mode) -->
            <div class="admin-sidebar-logo-row h-20 flex items-center justify-between px-6 border-b border-gray-50">
                <div class="flex min-w-0 items-center">
                    <div class="admin-sidebar-logo text-blue-600 mr-3 flex-shrink-0">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                    </div>
                    <div class="admin-sidebar-brand-text min-w-0">
                        <div class="font-bold text-xl text-gray-900 leading-tight">EduBridge</div>
                        <div class="text-xs text-gray-500 font-medium">Giáo viên</div>
                    </div>
                </div>
                <button type="button" class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600" aria-label="Thu gọn/mở rộng sidebar" aria-expanded="true">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Profile Info in Sidebar -->
            <div class="owner-sidebar-profile">
                <div class="owner-avatar">@initials</div>
                <div class="min-w-0">
                    <div class="owner-profile-name">@fullName</div>
                    <div class="owner-profile-status">Trực tuyến</div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="admin-sidebar-nav p-4 space-y-1.5 mt-2">
                <a href="/Teacher/Dashboard" title="Dashboard" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Dashboard" || ViewData["ActivePage"] == null ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span class="admin-sidebar-label">Dashboard</span>
                </a>
                <a href="/Teacher/Schedule" title="Lịch dạy" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Schedule" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span class="admin-sidebar-label">Lịch dạy</span>
                </a>
                <a href="/Teacher/Classes" title="Lớp học" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Classes" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    <span class="admin-sidebar-label">Lớp học</span>
                </a>
                <a href="/Teacher/Lectures" title="Quản lý buổi học" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Lectures" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5z"></path></svg>
                    <span class="admin-sidebar-label">Quản lý buổi học</span>
                </a>
                <a href="/Grades" title="Sổ điểm" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Grades" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
                    <span class="admin-sidebar-label">Sổ điểm</span>
                </a>
                <a href="/Teacher/Attendance" title="Điểm danh" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Attendance" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span class="admin-sidebar-label">Điểm danh</span>
                </a>
                <a href="/Messages" title="Tin nhắn" class="admin-sidebar-link flex items-center px-4 py-3 @(ViewData["ActivePage"] as string == "Messages" ? "bg-blue-50 text-blue-600 rounded-xl font-medium" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900 rounded-xl font-medium transition-colors")">
                    <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <span class="admin-sidebar-label">Tin nhắn</span>
                </a>
            </nav>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main flex-1 overflow-y-auto relative">
        <!-- Top bar containing Branch Selector -->
        @if (showCenterMenu && branches.Any())
        {
            <div class="flex justify-end mb-4">
                <form method="post" asp-page="/SetBranch" class="flex items-center space-x-2">
                    <label for="branchSelector" class="text-sm font-medium text-gray-700">Cơ sở:</label>
                    <select id="branchSelector" name="branchId" onchange="this.form.submit()" class="border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500">
                        <option value="0">Tất cả cơ sở</option>
                        @foreach (var branch in branches)
                        {
                            if (currentBranchId == branch.BranchId)
                            {
                                <option value="@branch.BranchId" selected>@branch.BranchName</option>
                            }
                            else
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        }
                    </select>
                </form>
            </div>
        }

        @if (isSupportMode)
        {
            <div class="bg-red-50 text-red-700 border border-red-200 px-4 py-3 rounded-xl mb-4 flex justify-between items-center shadow-sm">
                <div class="font-medium flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    Bạn đang trong chế độ Hỗ Trợ (Support Mode). Mọi thao tác sẽ được ghi lại.
                </div>
                <form method="post" asp-page="/SystemAdmin/ExitSupportMode">
                    <button type="submit" class="bg-white text-red-600 px-3 py-1.5 rounded-lg border border-red-200 text-sm font-bold hover:bg-red-50 transition-colors">
                        Thoát chế độ hỗ trợ
                    </button>
                </form>
            </div>
        }
        @RenderBody()
    </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const adminSidebarStorageKey = 'edubridge.admin.sidebar.collapsed';
        const adminSidebarToggle = document.getElementById('admin-sidebar-toggle');

        function setAdminSidebarCollapsed(isCollapsed) {
            document.body.classList.toggle('admin-sidebar-collapsed', isCollapsed);
            adminSidebarToggle?.setAttribute('aria-expanded', (!isCollapsed).toString());
            localStorage.setItem(adminSidebarStorageKey, isCollapsed ? 'true' : 'false');
        }

        setAdminSidebarCollapsed(localStorage.getItem(adminSidebarStorageKey) === 'true');
        adminSidebarToggle?.addEventListener('click', () => {
            setAdminSidebarCollapsed(!document.body.classList.contains('admin-sidebar-collapsed'));
        });

        document.querySelectorAll('#admin-sidebar .admin-sidebar-nav > a.admin-sidebar-link').forEach((link) => {
            const item = document.createElement('div');
            item.className = 'admin-sidebar-item';
            const label = link.querySelector('.admin-sidebar-label')?.textContent?.trim() || link.textContent.trim();
            const href = link.getAttribute('href') || '#';
            const isActive = link.classList.contains('bg-blue-50') || link.classList.contains('text-blue-600');

            link.parentNode.insertBefore(item, link);
            item.appendChild(link);
            link.setAttribute('role', 'button');
            link.setAttribute('aria-expanded', isActive.toString());

            const submenu = document.createElement('div');
            submenu.className = 'admin-sidebar-submenu';

            const submenuLink = document.createElement('a');
            submenuLink.href = href;
            submenuLink.className = `admin-sidebar-submenu-link${isActive ? ' is-active' : ''}`;
            submenuLink.textContent = label;
            submenu.appendChild(submenuLink);
            item.appendChild(submenu);

            item.classList.toggle('is-open', isActive);
            link.dataset.sidebarToggleBound = 'true';
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const shouldOpen = !item.classList.contains('is-open');
                item.classList.toggle('is-open', shouldOpen);
                link.setAttribute('aria-expanded', shouldOpen.toString());
            });
        });

        document.querySelectorAll('#admin-sidebar .admin-sidebar-item > .admin-sidebar-link').forEach((link) => {
            if (link.dataset.sidebarToggleBound === 'true') {
                return;
            }

            const item = link.closest('.admin-sidebar-item');
            if (!item) {
                return;
            }

            link.dataset.sidebarToggleBound = 'true';
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const shouldOpen = !item.classList.contains('is-open');
                item.classList.toggle('is-open', shouldOpen);
                link.setAttribute('aria-expanded', shouldOpen.toString());
            });
        });

        const adminProfileBtn = document.getElementById('adminProfileBtn');
        const adminProfileMenu = document.getElementById('adminProfileMenu');
        
        if (adminProfileBtn && adminProfileMenu) {
            adminProfileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                adminProfileMenu.classList.toggle('hidden');
                adminProfileBtn.setAttribute('aria-expanded', (!adminProfileMenu.classList.contains('hidden')).toString());
            });
            
            document.addEventListener('click', (e) => {
                if (!adminProfileMenu.contains(e.target) && !adminProfileBtn.contains(e.target)) {
                    adminProfileMenu.classList.add('hidden');
                    adminProfileBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        const layoutToastStorageKey = 'edubridge.admin.toasts';

        function getStoredLayoutToasts() {
            try {
                const value = localStorage.getItem(layoutToastStorageKey);
                const toasts = value ? JSON.parse(value) : [];
                const now = Date.now();

                return Array.isArray(toasts)
                    ? toasts.filter(toast => toast && toast.expiresAt > now)
                    : [];
            } catch {
                return [];
            }
        }

        function saveStoredLayoutToasts(toasts) {
            localStorage.setItem(layoutToastStorageKey, JSON.stringify(toasts));
        }

        function removeStoredLayoutToast(id) {
            saveStoredLayoutToasts(getStoredLayoutToasts().filter(toast => toast.id !== id));
        }

        function pushStoredLayoutToast(title, message, type) {
            if (!message) {
                return;
            }

            const toasts = getStoredLayoutToasts();
            toasts.push({
                id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
                title,
                message,
                type,
                expiresAt: Date.now() + 4500
            });

            saveStoredLayoutToasts(toasts);
        }

        function showLayoutToast(title, message, type, id, remainingMs) {
            if (!message) {
                return;
            }

            const container = document.getElementById('layout-toast-container');
            const isError = type === 'error' || type === 'danger' || type === 'failed';
            const toast = document.createElement('div');
            const colorClasses = isError
                ? 'border-red-300 bg-red-100 text-red-900'
                : 'border-green-300 bg-green-100 text-green-900';
            const iconColor = isError ? 'text-red-700' : 'text-green-700';

            toast.className = `${colorClasses} pointer-events-auto flex translate-x-5 gap-3 rounded border-l-4 px-4 py-4 opacity-0 shadow-xl transition-all duration-300`;
            toast.innerHTML = `
                <div class="${iconColor} mt-0.5 flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-white/60">
                    ${isError
                        ? '<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M6 18L18 6M6 6l12 12"></path></svg>'
                        : '<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7"></path></svg>'}
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-base font-bold leading-5">${title || (isError ? 'Thất bại' : 'Thành công')}</div>
                    <div class="mt-1 text-sm font-medium leading-5">${message}</div>
                </div>
                <button type="button" class="${iconColor} -mr-1 -mt-1 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded hover:bg-white/60" aria-label="Đóng thông báo">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;

            const closeToast = () => {
                toast.classList.add('translate-x-5', 'opacity-0');
                if (id) {
                    removeStoredLayoutToast(id);
                }
                setTimeout(() => toast.remove(), 300);
            };

            toast.querySelector('button')?.addEventListener('click', closeToast);
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-x-5', 'opacity-0');
            });

            setTimeout(closeToast, Math.max(1200, remainingMs ?? 4500));
        }

        window.showToast = function(message, isSuccess = true) {
            const type = isSuccess ? 'success' : 'error';
            const title = isSuccess ? 'Thành công' : 'Thất bại';
            showLayoutToast(title, message, type, null, 4500);
        };

        pushStoredLayoutToast(
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastTitle"] as string)),
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"] as string)),
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastType"] as string))
        );

        getStoredLayoutToasts().forEach(toast => {
            showLayoutToast(
                toast.title,
                toast.message,
                toast.type,
                toast.id,
                toast.expiresAt - Date.now()
            );
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
