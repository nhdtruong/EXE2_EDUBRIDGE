@page
@model EduBridge.Pages.AdminParentsModel
@{
    ViewData["Title"] = "Quản lý phụ huynh";
    Layout = "_AdminLayout";
    ViewData["ActivePage"] = "AdminParents";
    var selectedStatusText = Model.StatusFilter switch
    {
        "Active" => "Đang hoạt động",
        "Inactive" => "Tạm dừng",
        _ => "Trạng thái"
    };
    var selectedChildrenText = Model.ChildrenFilter switch
    {
        "yes" => "Có học sinh",
        "no" => "Chưa có học sinh",
        _ => "Liên kết học sinh"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/design-system/pagination.css" />
}

<div class="mb-5">
    <h1 class="text-2xl font-bold text-gray-900">Quản lý phụ huynh</h1>
    <p class="mt-1 text-sm text-gray-500">Quản lý tài khoản phụ huynh và học sinh liên kết</p>
</div>

<section class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-200">
    <div class="bg-blue-50/60 p-5">
        <h2 class="mb-4 text-base font-bold text-gray-900">Danh sách phụ huynh</h2>
        <form method="get" class="space-y-4">
            <input type="hidden" name="PageNumber" value="1">
            <input type="hidden" asp-for="PageSize">
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-5">
            <div>
                <input asp-for="NameFilter" class="h-11 w-full rounded border border-gray-300 bg-white px-3 text-sm" placeholder="Tên phụ huynh">
            </div>
            <div>
                <input asp-for="EmailFilter" class="h-11 w-full rounded border border-gray-300 bg-white px-3 text-sm" placeholder="Email">
            </div>
            <div>
                <input asp-for="PhoneFilter" class="h-11 w-full rounded border border-gray-300 bg-white px-3 text-sm" placeholder="Số điện thoại">
            </div>
            <div class="relative w-full" data-search-dropdown>
                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" data-filter-value="parent-status" />
                <button type="button" data-dropdown-toggle class="flex h-11 w-full items-center justify-between rounded border border-gray-300 bg-white px-3 text-left text-sm text-gray-600 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <span data-dropdown-label>@selectedStatusText</span>
                    <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div data-dropdown-panel class="absolute left-0 top-[calc(100%+4px)] z-40 hidden w-full rounded border border-gray-300 bg-white shadow-lg">
                    <div class="relative p-2">
                        <input type="text" data-dropdown-search class="h-10 w-full rounded border border-blue-400 px-3 pr-9 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
                        <svg class="absolute right-4 top-4 h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <button type="button" data-dropdown-option data-value="" data-label="Trạng thái" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Tất cả</button>
                    <button type="button" data-dropdown-option data-value="Active" data-label="Đang hoạt động" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Đang hoạt động</button>
                    <button type="button" data-dropdown-option data-value="Inactive" data-label="Tạm dừng" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Tạm dừng</button>
                </div>
            </div>
            <div class="relative w-full" data-search-dropdown>
                <input type="hidden" name="ChildrenFilter" value="@Model.ChildrenFilter" data-filter-value="parent-children" />
                <button type="button" data-dropdown-toggle class="flex h-11 w-full items-center justify-between rounded border border-gray-300 bg-white px-3 text-left text-sm text-gray-600 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <span data-dropdown-label>@selectedChildrenText</span>
                    <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div data-dropdown-panel class="absolute left-0 top-[calc(100%+4px)] z-40 hidden w-full rounded border border-gray-300 bg-white shadow-lg">
                    <div class="relative p-2">
                        <input type="text" data-dropdown-search class="h-10 w-full rounded border border-blue-400 px-3 pr-9 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
                        <svg class="absolute right-4 top-4 h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <button type="button" data-dropdown-option data-value="" data-label="Liên kết học sinh" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Tất cả</button>
                    <button type="button" data-dropdown-option data-value="yes" data-label="Có học sinh" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Có học sinh</button>
                    <button type="button" data-dropdown-option data-value="no" data-label="Chưa có học sinh" class="block w-full px-4 py-2 text-left text-sm hover:bg-blue-50">Chưa có học sinh</button>
                </div>
            </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap gap-3">
                    <a asp-page="/AdminParents/Create" class="inline-flex h-9 items-center justify-center rounded bg-[#008dde] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#007cbd] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#008dde]">
                        <span class="mr-1.5 text-lg leading-none">+</span> Thêm mới
                    </a>
                    <button type="button" onclick="window.openImportModal()" class="inline-flex h-9 items-center justify-center rounded bg-[#6e9e3d] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#5c8733] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6e9e3d]">
                        <svg class="mr-1.5 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                        Import
                    </button>
                    <a asp-page-handler="Export" 
                       asp-route-NameFilter="@Model.NameFilter" 
                       asp-route-EmailFilter="@Model.EmailFilter" 
                       asp-route-PhoneFilter="@Model.PhoneFilter" 
                       asp-route-StatusFilter="@Model.StatusFilter" 
                       asp-route-ChildrenFilter="@Model.ChildrenFilter"
                       class="inline-flex h-9 items-center justify-center rounded bg-[#6e9e3d] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#5c8733] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#6e9e3d]">
                        <svg class="mr-1.5 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Export
                    </a>
                    <button type="button" onclick="window.openHistoryModal()" class="inline-flex h-9 items-center justify-center rounded bg-[#ffbe2e] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#e6ab29] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ffbe2e]">
                        Lịch sử Import/Export
                    </button>
                </div>
                <div class="flex gap-3">
                    <a asp-page="/AdminParents" class="inline-flex h-10 items-center rounded bg-slate-700 px-4 text-sm font-semibold text-white">Làm mới bộ lọc</a>
                    <button class="inline-flex h-10 items-center rounded bg-blue-600 px-4 text-sm font-semibold text-white">Tìm kiếm</button>
                </div>
            </div>
        </form>
    </div>
    <div asp-validation-summary="ModelOnly" class="px-4 py-2 text-sm font-semibold text-red-600"></div>
    <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-100 text-gray-800"><tr>
                <th class="border-r border-slate-200 px-4 py-4 text-center">STT</th>
                <th class="border-r border-slate-200 px-4 py-4 text-center">ID</th>
                <th class="border-r border-slate-200 px-5 py-4 text-left">Phụ huynh</th>
                <th class="border-r border-slate-200 px-5 py-4 text-left">Email</th>
                <th class="border-r border-slate-200 px-5 py-4 text-left">Số điện thoại</th>
                <th class="border-r border-slate-200 px-5 py-4 text-left">Học sinh liên kết</th>
                <th class="border-r border-slate-200 px-4 py-4 text-center">Ngày tạo</th>
                <th class="border-r border-slate-200 px-5 py-4 text-center">Trạng thái tại trung tâm</th>
                <th class="px-5 py-4 text-center">Thao tác</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-200">
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="9" class="px-6 py-10 text-center text-gray-500">Chưa có phụ huynh phù hợp.</td></tr>
            }
            @for (var i = 0; i < Model.Result.Items.Count; i++)
            {
                var item = Model.Result.Items[i];
                <tr class="hover:bg-blue-50/50">
                    <td class="border-r border-gray-200 px-4 py-4 text-center">@((Model.Result.Page - 1) * Model.Result.PageSize + i + 1)</td>
                    <td class="border-r border-gray-200 px-4 py-4 text-center">@item.UserId</td>
                    <td class="border-r border-gray-200 px-5 py-4"><div class="font-semibold text-gray-900">@item.FullName</div></td>
                    <td class="border-r border-gray-200 px-5 py-4 text-gray-600">@(item.Email ?? "-")</td>
                    <td class="border-r border-gray-200 px-5 py-4 text-gray-600">@(item.PhoneNumber ?? "-")</td>
                    <td class="border-r border-gray-200 px-5 py-4"><div class="font-semibold">@item.ChildrenCount học sinh</div><div class="max-w-64 truncate text-gray-500" title="@string.Join(", ", item.ChildrenNames)">@string.Join(", ", item.ChildrenNames)</div></td>
                    <td class="border-r border-gray-200 px-4 py-4 text-center">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="border-r border-gray-200 px-5 py-4 text-center">
                        <form method="post" asp-page-handler="ToggleStatus" asp-route-parentUserId="@item.UserId" asp-route-currentStatus="@item.Status">
                            <input type="hidden" asp-for="NameFilter"><input type="hidden" asp-for="EmailFilter"><input type="hidden" asp-for="PhoneFilter"><input type="hidden" asp-for="StatusFilter"><input type="hidden" asp-for="ChildrenFilter"><input type="hidden" asp-for="PageNumber"><input type="hidden" asp-for="PageSize">
                            <button class="inline-flex items-center gap-3 rounded-full border px-3 py-1.5 text-xs font-semibold transition-colors @(item.Status == "Active" ? "border-green-200 bg-green-50 text-green-700 hover:bg-green-100" : "border-gray-200 bg-gray-100 text-gray-600 hover:bg-gray-200")" title="Đổi trạng thái phụ huynh tại trung tâm">
                                <span class="relative h-6 w-11 rounded-full @(item.Status == "Active" ? "bg-green-500" : "bg-gray-300")"><span class="absolute top-0.5 h-5 w-5 rounded-full bg-white shadow @(item.Status == "Active" ? "left-5" : "left-0.5")"></span></span>
                                <span class="min-w-20 text-left">@(item.Status == "Active" ? "Đang hoạt động" : "Tạm dừng")</span>
                            </button>
                        </form>
                    </td>
                    <td class="px-5 py-4 text-center"><div class="flex justify-center gap-3"><a asp-page="/AdminParents/Edit" asp-route-id="@item.UserId" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-blue-500 bg-blue-50 text-blue-600 transition-colors hover:bg-blue-100" title="Xem chi tiết/Sửa">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </a>
                    <button type="button" data-reset-parent="@item.UserId" data-parent-name="@item.FullName" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-blue-500 bg-white text-blue-600 transition-colors hover:bg-blue-50" title="Cấp lại mật khẩu nhanh">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M19 9A7 7 0 007.05 4.05M5 15a7 7 0 0011.95 4.95"></path></svg>
                    </button>
                    <button type="button" data-delete-parent="@item.UserId" data-parent-name="@item.FullName" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-red-500 bg-red-50 text-red-500 transition-colors hover:bg-red-100" title="Xóa phụ huynh">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-6 border-t border-gray-200 bg-white px-6 py-4 text-sm text-gray-600">
        <div class="flex items-center gap-1">
            <a asp-route-pageNumber="1" asp-route-pageSize="@Model.Result.PageSize" asp-route-nameFilter="@Model.NameFilter" asp-route-emailFilter="@Model.EmailFilter" asp-route-phoneFilter="@Model.PhoneFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-childrenFilter="@Model.ChildrenFilter" class="inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-blue-50 hover:text-blue-600 @(Model.Result.Page <= 1 ? "pointer-events-none opacity-40" : "")">«</a>
            <a asp-route-pageNumber="@(Math.Max(1, Model.Result.Page - 1))" asp-route-pageSize="@Model.Result.PageSize" asp-route-nameFilter="@Model.NameFilter" asp-route-emailFilter="@Model.EmailFilter" asp-route-phoneFilter="@Model.PhoneFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-childrenFilter="@Model.ChildrenFilter" class="inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-blue-50 hover:text-blue-600 @(Model.Result.Page <= 1 ? "pointer-events-none opacity-40" : "")">‹</a>
            @for (var pageIndex = Math.Max(1, Model.Result.Page - 2); pageIndex <= Math.Min(Model.Result.TotalPages, Model.Result.Page + 2); pageIndex++)
            {
                <a asp-route-pageNumber="@pageIndex" asp-route-pageSize="@Model.Result.PageSize" asp-route-nameFilter="@Model.NameFilter" asp-route-emailFilter="@Model.EmailFilter" asp-route-phoneFilter="@Model.PhoneFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-childrenFilter="@Model.ChildrenFilter" class="inline-flex h-9 min-w-9 items-center justify-center rounded px-3 @(pageIndex == Model.Result.Page ? "bg-blue-100 font-semibold text-blue-700" : "text-gray-600 hover:bg-blue-50 hover:text-blue-600")">@pageIndex</a>
            }
            <a asp-route-pageNumber="@(Math.Min(Model.Result.TotalPages, Model.Result.Page + 1))" asp-route-pageSize="@Model.Result.PageSize" asp-route-nameFilter="@Model.NameFilter" asp-route-emailFilter="@Model.EmailFilter" asp-route-phoneFilter="@Model.PhoneFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-childrenFilter="@Model.ChildrenFilter" class="inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-blue-50 hover:text-blue-600 @(Model.Result.Page >= Model.Result.TotalPages ? "pointer-events-none opacity-40" : "")">›</a>
            <a asp-route-pageNumber="@Model.Result.TotalPages" asp-route-pageSize="@Model.Result.PageSize" asp-route-nameFilter="@Model.NameFilter" asp-route-emailFilter="@Model.EmailFilter" asp-route-phoneFilter="@Model.PhoneFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-childrenFilter="@Model.ChildrenFilter" class="inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-blue-50 hover:text-blue-600 @(Model.Result.Page >= Model.Result.TotalPages ? "pointer-events-none opacity-40" : "")">»</a>
        </div>
        <span class="font-medium">Tổng số: @Model.Result.TotalItems bản ghi</span>
        <form method="get" class="flex items-center">
            <input type="hidden" asp-for="NameFilter"><input type="hidden" asp-for="EmailFilter"><input type="hidden" asp-for="PhoneFilter"><input type="hidden" asp-for="StatusFilter"><input type="hidden" asp-for="ChildrenFilter"><input type="hidden" name="PageNumber" value="1">
            <select name="PageSize" onchange="this.form.submit()" class="h-10 rounded border border-blue-400 bg-white px-3 text-sm text-gray-700">
                @foreach (var size in new[] { 10, 20, 50, 100, 200, 500 }) { <option value="@size" selected="@(Model.Result.PageSize == size)">@size</option> }
            </select>
        </form>
    </div>
</section>

<div id="resetPasswordConfirmModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-md rounded-xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b px-5 py-4">
            <h2 class="text-lg font-bold">Cấp lại mật khẩu</h2>
            <button type="button" data-close-reset-confirm class="text-2xl text-gray-400">&times;</button>
        </div>
        <div class="p-6 text-sm text-gray-700">
            Bạn có chắc muốn cấp lại mật khẩu cho <strong id="resetParentName" class="text-gray-900"></strong>?
            Mật khẩu hiện tại sẽ không còn sử dụng được.
        </div>
        <div class="flex justify-end gap-3 border-t px-5 py-4">
            <button type="button" data-close-reset-confirm class="rounded border border-gray-300 px-5 py-2 text-sm font-semibold">Hủy</button>
            <form method="post" asp-page-handler="ResetPassword">
                <input id="resetParentUserId" name="parentUserId" type="hidden">
                <input type="hidden" asp-for="NameFilter"><input type="hidden" asp-for="EmailFilter"><input type="hidden" asp-for="PhoneFilter"><input type="hidden" asp-for="StatusFilter"><input type="hidden" asp-for="ChildrenFilter"><input type="hidden" asp-for="PageNumber"><input type="hidden" asp-for="PageSize">
                <button type="submit" class="rounded bg-blue-600 px-5 py-2 text-sm font-semibold text-white">Cấp mật khẩu</button>
            </form>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ResetPasswordResult))
{
    <div id="resetPasswordResultModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div class="w-full max-w-md rounded-xl bg-white shadow-2xl">
            <div class="flex items-center justify-between border-b px-5 py-4"><h2 class="text-lg font-bold">Mật khẩu mới</h2><button type="button" onclick="document.getElementById('resetPasswordResultModal').remove()" class="text-2xl text-gray-400">&times;</button></div>
            <div class="p-6 text-center"><p class="text-sm text-gray-600">Mật khẩu tạm thời chỉ hiển thị một lần:</p><div class="mt-3 text-3xl font-bold tracking-widest text-blue-700">@Model.ResetPasswordResult</div></div>
            <div class="flex justify-end border-t px-5 py-4"><button type="button" onclick="document.getElementById('resetPasswordResultModal').remove()" class="rounded bg-blue-600 px-5 py-2 text-sm font-semibold text-white">Đóng</button></div>
        </div>
    </div>
}

<div id="deleteParentConfirmModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black bg-opacity-50 px-4">
    <div class="w-full max-w-xl rounded bg-white shadow-2xl">
        <div class="flex items-center justify-end border-b border-gray-100 px-5 py-4">
            <button type="button" data-close-delete-confirm class="text-gray-500 hover:text-gray-700">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="flex items-start gap-4 px-6 py-6">
            <div class="mt-1 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border-2 border-red-500 text-red-600">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path></svg>
            </div>
            <div>
                <p class="text-sm text-gray-700">Bạn có chắc chắn muốn xóa tài khoản phụ huynh này?</p>
                <p id="deleteParentName" class="mt-1 text-sm font-semibold text-gray-900"></p>
                <p class="mt-3 text-xs text-gray-500">Hệ thống sẽ chặn tính năng xóa nếu phụ huynh đang quản lý học sinh ở trạng thái "Đang hoạt động".</p>
            </div>
        </div>
        <form method="post" asp-page-handler="Delete">
            <input id="deleteParentUserId" type="hidden" name="parentUserId" />
            <input type="hidden" asp-for="NameFilter"><input type="hidden" asp-for="EmailFilter"><input type="hidden" asp-for="PhoneFilter"><input type="hidden" asp-for="StatusFilter"><input type="hidden" asp-for="ChildrenFilter"><input type="hidden" asp-for="PageNumber"><input type="hidden" asp-for="PageSize">
            <div class="flex justify-end gap-5 px-6 pb-6">
                <button type="button" data-close-delete-confirm class="text-sm font-semibold text-blue-600 hover:text-blue-700">Hủy</button>
                <button type="submit" class="rounded bg-red-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700">Xóa</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById('resetPasswordConfirmModal');
            const parentId = document.getElementById('resetParentUserId');
            const parentName = document.getElementById('resetParentName');
            const close = () => {
                modal?.classList.add('hidden');
                modal?.classList.remove('flex');
            };

            document.querySelectorAll('[data-reset-parent]').forEach(button => button.addEventListener('click', () => {
                parentId.value = button.dataset.resetParent;
                parentName.textContent = button.dataset.parentName || 'phụ huynh này';
                modal?.classList.remove('hidden');
                modal?.classList.add('flex');
            }));
            document.querySelectorAll('[data-close-reset-confirm]').forEach(button => button.addEventListener('click', close));
            modal?.addEventListener('click', event => {
                if (event.target === modal) close();
            });

            // Delete Modal
            const deleteModal = document.getElementById('deleteParentConfirmModal');
            const deleteParentId = document.getElementById('deleteParentUserId');
            const deleteParentName = document.getElementById('deleteParentName');
            const closeDelete = () => {
                deleteModal?.classList.add('hidden');
                deleteModal?.classList.remove('flex');
            };

            document.querySelectorAll('[data-delete-parent]').forEach(button => button.addEventListener('click', () => {
                deleteParentId.value = button.dataset.deleteParent;
                deleteParentName.textContent = button.dataset.parentName || 'phụ huynh này';
                deleteModal?.classList.remove('hidden');
                deleteModal?.classList.add('flex');
            }));
            document.querySelectorAll('[data-close-delete-confirm]').forEach(button => button.addEventListener('click', closeDelete));
            deleteModal?.addEventListener('click', event => {
                if (event.target === deleteModal) closeDelete();
            });

            document.querySelectorAll('[data-search-dropdown]').forEach(dropdown => {
                const container = dropdown.parentElement;
                const hiddenInput = container.querySelector('[data-filter-value]') || dropdown.querySelector('[data-filter-value]');
                const toggle = dropdown.querySelector('[data-dropdown-toggle]');
                const panel = dropdown.querySelector('[data-dropdown-panel]');
                const label = dropdown.querySelector('[data-dropdown-label]');
                const searchInput = dropdown.querySelector('[data-dropdown-search]');
                const options = Array.from(dropdown.querySelectorAll('[data-dropdown-option]'));

                function close() {
                    panel.classList.add('hidden');
                }

                function open() {
                    document.querySelectorAll('[data-dropdown-panel]').forEach(item => item.classList.add('hidden'));
                    panel.classList.remove('hidden');
                    searchInput.value = '';
                    filterOptions('');
                    searchInput.focus();
                }

                function filterOptions(keyword) {
                    const normalizedKeyword = keyword.trim().toLowerCase();

                    options.forEach(option => {
                        const text = option.textContent.trim().toLowerCase();
                        const labelText = (option.dataset.label || '').toLowerCase();
                        const visible = !normalizedKeyword ||
                            text.includes(normalizedKeyword) ||
                            labelText.includes(normalizedKeyword);

                        option.classList.toggle('hidden', !visible);
                    });
                }

                toggle.addEventListener('click', event => {
                    event.stopPropagation();

                    if (panel.classList.contains('hidden')) {
                        open();
                    } else {
                        close();
                    }
                });

                searchInput.addEventListener('input', () => filterOptions(searchInput.value));
                searchInput.addEventListener('click', event => event.stopPropagation());

                options.forEach(option => {
                    option.addEventListener('click', () => {
                        hiddenInput.value = option.dataset.value || '';
                        label.textContent = option.dataset.label || option.textContent.trim();
                        close();
                    });
                });

                document.addEventListener('click', event => {
                    if (!dropdown.contains(event.target)) {
                        close();
                    }
                });
            });
        })();
    </script>
}

<!-- Modal History -->
<div id="historyModal" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 p-4 pt-16">
    <div class="relative w-full max-w-7xl rounded-xl bg-white shadow-2xl" onclick="event.stopPropagation()">
        <div class="flex items-center justify-between border-b border-gray-100 p-4">
            <h3 class="text-lg font-bold text-gray-900">Lịch sử Import/Export</h3>
            <button type="button" onclick="closeHistoryModal()" class="flex h-8 w-8 items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-4" style="max-height: calc(100vh - 120px); overflow-y: auto;">
            <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
                <table class="min-w-full text-sm">
                    <thead class="bg-gray-50 text-gray-700">
                        <tr>
                            <th class="border-b px-4 py-3 text-center font-semibold">STT</th>
                            <th class="border-b px-4 py-3 text-left font-semibold">Tiêu đề</th>
                            <th class="border-b px-4 py-3 text-left font-semibold">Người thao tác</th>
                            <th class="border-b px-4 py-3 text-center font-semibold">Hành động</th>
                            <th class="border-b px-4 py-3 text-center font-semibold">File nhập liệu</th>
                            <th class="border-b px-4 py-3 text-center font-semibold">File kết quả</th>
                            <th class="border-b px-4 py-3 text-center font-semibold">Trạng thái</th>
                            <th class="border-b px-4 py-3 text-left font-semibold">Thông báo lỗi</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-gray-100 bg-white">
                    </tbody>
                </table>
            </div>
            <div id="historyPaginationContainer" class="mt-4 flex justify-center">
            </div>
        </div>
    </div>
</div>

<script>
    window.openHistoryModal = function() {
        const modal = document.getElementById('historyModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        window.loadHistory(1);
    };

    window.closeHistoryModal = function() {
        const modal = document.getElementById('historyModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };

    let currentHistoryPageSize = 10;

    window.loadHistory = async function(page, pageSize) {
        if (pageSize) {
            currentHistoryPageSize = pageSize;
        } else {
            pageSize = currentHistoryPageSize;
        }

        const tbody = document.getElementById('historyTableBody');
        const paginationContainer = document.getElementById('historyPaginationContainer');
        
        try {
            tbody.innerHTML = '<tr><td colspan="8" class="py-4 text-center text-gray-500">Đang tải dữ liệu...</td></tr>';
            const response = await fetch('?handler=History&page=' + page + '&pageSize=' + pageSize);
            const result = await response.json();
            
            if (!result.isSuccess) {
                tbody.innerHTML = '<tr><td colspan="8" class="py-4 text-center text-red-500">Lỗi tải dữ liệu.</td></tr>';
                return;
            }

            const data = result.value;

            if (data.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="py-4 text-center text-gray-500">Chưa có lịch sử.</td></tr>';
                if (paginationContainer) paginationContainer.innerHTML = '';
                return;
            }

            let html = '';
            data.items.forEach((item, index) => {
                const stt = (data.page - 1) * data.pageSize + index + 1;
                let statusHtml = '';
                if (item.status === 'Completed') statusHtml = '<span class="inline-flex rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Đã xử lý</span>';
                else if (item.status === 'Processing') statusHtml = '<span class="inline-flex rounded-full bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">Đang xử lý</span>';
                else statusHtml = '<span class="inline-flex rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-800">Lỗi</span>';

                const inputFileUrl = item.inputFileUrl ? (item.inputFileUrl.startsWith('/') ? item.inputFileUrl : '/' + item.inputFileUrl) : '#';
                const resultFileUrl = item.resultFileUrl ? (item.resultFileUrl.startsWith('/') ? item.resultFileUrl : '/' + item.resultFileUrl) : '#';

                const inputFile = item.inputFileUrl ? `<a href="${inputFileUrl}" target="_blank" class="text-green-600 hover:text-green-800"><svg class="inline-block h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6zm2-6h8v2H8v-2z"></path></svg></a>` : '';
                const resultFile = item.resultFileUrl ? `<a href="${resultFileUrl}" target="_blank" class="text-green-600 hover:text-green-800"><svg class="inline-block h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6zm2-6h8v2H8v-2z"></path></svg></a>` : '';

                html += `<tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="border-r px-4 py-2 text-center">${stt}</td>
                    <td class="border-r px-4 py-2 text-left">${item.title}</td>
                    <td class="border-r px-4 py-2 text-left">${item.actorName}</td>
                    <td class="border-r px-4 py-2 text-center">${item.actionType}</td>
                    <td class="border-r px-4 py-2 text-center">${inputFile}</td>
                    <td class="border-r px-4 py-2 text-center">${resultFile}</td>
                    <td class="border-r px-4 py-2 text-center">${statusHtml}</td>
                    <td class="px-4 py-2 text-left text-xs text-red-500">${item.errorMessage || ''}</td>
                </tr>`;
            });
            tbody.innerHTML = html;

            // Pagination (Tailwind)
            let pagHtml = '<div class="flex flex-wrap items-center justify-between gap-4 mt-4 text-sm text-gray-600">';
            pagHtml += '<div class="flex items-center gap-1">';
            
            const getBtnClass = (disabled) => `inline-flex h-8 w-8 items-center justify-center rounded text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600 ${disabled ? 'pointer-events-none opacity-40' : ''}`;
            const getPageClass = (active) => `inline-flex h-8 min-w-8 items-center justify-center rounded px-2 font-medium transition-colors ${active ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-blue-50 hover:text-blue-600'}`;
            
            pagHtml += `<a href="javascript:void(0)" ${data.page > 1 ? `onclick="window.loadHistory(1)"` : ''} class="${getBtnClass(data.page === 1)}" title="Trang đầu">&laquo;</a>`;
            pagHtml += `<a href="javascript:void(0)" ${data.page > 1 ? `onclick="window.loadHistory(${data.page - 1})"` : ''} class="${getBtnClass(data.page === 1)}" title="Trang trước">&lsaquo;</a>`;

            let startPage = Math.max(1, data.page - 2);
            let endPage = Math.min(data.totalPages, startPage + 4);
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }

            for (let i = startPage; i <= endPage; i++) {
                pagHtml += `<a href="javascript:void(0)" onclick="window.loadHistory(${i})" class="${getPageClass(i === data.page)}">${i}</a>`;
            }

            const canGoNext = data.page < data.totalPages && data.totalPages > 0;
            pagHtml += `<a href="javascript:void(0)" ${canGoNext ? `onclick="window.loadHistory(${data.page + 1})"` : ''} class="${getBtnClass(!canGoNext)}" title="Trang sau">&rsaquo;</a>`;
            pagHtml += `<a href="javascript:void(0)" ${canGoNext ? `onclick="window.loadHistory(${data.totalPages})"` : ''} class="${getBtnClass(!canGoNext)}" title="Trang cuối">&raquo;</a>`;
            
            pagHtml += `</div><div class="flex items-center gap-3">`;
            pagHtml += `<span>Tổng số: ${data.totalItems} bản ghi</span>`;
            pagHtml += `<select class="h-8 rounded border border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500 bg-white" onchange="window.loadHistory(1, this.value)">`;
            [10, 20, 50, 100, 200, 500].forEach(size => {
                pagHtml += `<option value="${size}" ${data.pageSize == size ? 'selected' : ''}>${size}</option>`;
            });
            pagHtml += `</select>`;
            pagHtml += `</div></div>`;
            
            if (paginationContainer) {
                paginationContainer.innerHTML = pagHtml;
            }

        } catch (e) {
            console.error(e);
            tbody.innerHTML = `<tr><td colspan="8" class="py-4 text-center text-red-500">Lỗi kết nối: ${e.message || e.toString()}</td></tr>`;
        }
    };
</script>

<!-- Modal Import -->
<div id="importModal" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/50 p-4 pt-20">
    <div class="relative w-full max-w-3xl bg-white shadow-2xl" onclick="event.stopPropagation()">
        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4">
            <h3 class="text-xl font-bold text-gray-700">Import phụ huynh</h3>
            <button type="button" onclick="closeImportModal()" class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-blue-300 text-gray-500 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <!-- Body -->
        <div class="p-6 pt-0">
            <div class="border border-gray-200 p-10 min-h-[250px] flex items-center justify-center">
                <form id="importForm" method="post" enctype="multipart/form-data" asp-page-handler="ImportExcel" class="w-full">
                    <input type="hidden" name="NameFilter" value="@Model.NameFilter"><input type="hidden" name="EmailFilter" value="@Model.EmailFilter"><input type="hidden" name="PhoneFilter" value="@Model.PhoneFilter"><input type="hidden" name="StatusFilter" value="@Model.StatusFilter"><input type="hidden" name="ChildrenFilter" value="@Model.ChildrenFilter"><input type="hidden" name="PageNumber" value="@Model.PageNumber"><input type="hidden" name="PageSize" value="@Model.PageSize">
                    
                    <div class="flex flex-col items-center justify-center space-y-8">
                        <!-- Custom File Input -->
                        <div class="flex flex-col items-center">
                            <button type="button" onclick="document.getElementById('importFile').click()" class="bg-[#0078d4] hover:bg-blue-700 text-white px-6 py-2.5 rounded text-sm font-medium transition-colors shadow-sm">
                                Choose a file
                            </button>
                            <input type="file" id="importFile" name="importFile" accept=".xlsx,.xls" class="hidden" onchange="document.getElementById('fileNameDisplay').textContent = this.files.length > 0 ? this.files[0].name : ''" required />
                            <div id="fileNameDisplay" class="mt-3 text-sm text-gray-600 font-medium min-h-[20px]"></div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-center gap-3">
                            <button type="button" onclick="document.getElementById('importFile').value = ''; document.getElementById('fileNameDisplay').textContent = '';" class="border border-gray-400 text-[#0078d4] hover:bg-gray-50 px-6 py-2.5 text-sm font-medium transition-colors shadow-sm bg-white">
                                Bỏ chọn file
                            </button>
                            <button type="submit" class="bg-[#0078d4] hover:bg-blue-700 text-white px-8 py-2.5 text-sm font-medium transition-colors shadow-sm">
                                Import
                            </button>
                            <a href="?handler=DownloadTemplate" class="inline-flex items-center justify-center bg-[#0078d4] hover:bg-blue-700 text-white px-6 py-2.5 text-sm font-medium transition-colors shadow-sm">
                                Tải file mẫu
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    window.openImportModal = function() {
        const modal = document.getElementById('importModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    };

    window.closeImportModal = function() {
        const modal = document.getElementById('importModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    };
</script>
