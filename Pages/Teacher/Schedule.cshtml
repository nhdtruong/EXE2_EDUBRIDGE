@page
@model EduBridge.Pages.Teacher.ScheduleModel
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Lịch dạy Giáo viên";
}

<!-- Welcome Section -->
<div class="mb-6 p-6 rounded-3xl bg-gradient-to-br from-white to-blue-50 border border-slate-200/80 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-blue-700">Lịch dạy của bạn</h1>
        <p class="text-slate-500 mt-1 text-sm font-medium">Giáo viên: @Model.TeacherName</p>
    </div>
    
    <!-- Filter Form -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <div class="flex items-center space-x-2">
            <label for="yearFilter" class="text-xs font-bold text-slate-500 uppercase">Năm:</label>
            <select id="yearFilter" name="year" onchange="this.form.submit()" class="border-slate-200 rounded-xl text-sm focus:ring-blue-500 focus:border-blue-500 font-semibold py-1 px-3 shadow-sm bg-white min-h-[38px] h-[38px] border">
                @foreach (var yr in Model.AvailableYears)
                {
                    if (yr == Model.SelectedYear)
                    {
                        <option value="@yr" selected>@yr</option>
                    }
                    else
                    {
                        <option value="@yr">@yr</option>
                    }
                }
            </select>
        </div>
        
        <div class="flex items-center space-x-2">
            <label for="weekFilter" class="text-xs font-bold text-slate-500 uppercase">Tuần:</label>
            <select id="weekFilter" name="weekRange" onchange="this.form.submit()" class="border-slate-200 rounded-xl text-sm focus:ring-blue-500 focus:border-blue-500 font-semibold py-1 px-3 shadow-sm bg-white min-h-[38px] h-[38px] border">
                @foreach (var wk in Model.Weeks)
                {
                    var isSelected = wk.RangeValue == Model.SelectedWeekRange;
                    var labelText = wk.IsCurrent ? $"{wk.Label} (Tuần hiện tại)" : wk.Label;
                    if (isSelected)
                    {
                        <option value="@wk.RangeValue" selected>@labelText</option>
                    }
                    else
                    {
                        <option value="@wk.RangeValue">@labelText</option>
                    }
                }
            </select>
        </div>
    </form>
</div>

<!-- Weekly Schedule Table (table-fixed for strict column alignment) -->
<div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden mb-8">
    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-slate-600 text-sm table-fixed min-w-[1100px]">
            <thead class="bg-slate-100 border-b border-slate-200 text-slate-800 font-bold uppercase text-[11px] tracking-wider">
                <tr>
                    <!-- Time Column Header (12% width) -->
                    <th scope="col" class="px-4 py-4 text-center border-r border-slate-200 w-[12%]">
                        Thời gian
                    </th>
                    <!-- 7 Days Columns (Each 12.57% width to sum to ~100% with Time column) -->
                    @for (int i = 0; i < 7; i++)
                    {
                        var day = Model.DaysOfWeek[i];
                        var dayLabel = i switch
                        {
                            0 => "Thứ Hai",
                            1 => "Thứ Ba",
                            2 => "Thứ Tư",
                            3 => "Thứ Năm",
                            4 => "Thứ Sáu",
                            5 => "Thứ Bảy",
                            _ => "Chủ Nhật"
                        };
                        var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                        var cellClass = isToday ? "bg-blue-50/50 text-blue-700" : "text-slate-700";
                        
                        <th scope="col" class="px-4 py-4 font-extrabold text-center border-r border-slate-200 w-[12.57%] @cellClass">
                            <div class="uppercase tracking-wider text-xs font-bold @(isToday ? "text-blue-500" : "text-slate-400")">@dayLabel</div>
                            <div class="text-base font-bold mt-1">@day.ToString("dd/MM")</div>
                            @if (isToday)
                            {
                                <span class="inline-block mt-1 px-2 py-0.5 bg-blue-100 text-blue-600 text-[10px] font-extrabold rounded-full border border-blue-200 shadow-sm uppercase">Hôm nay</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @if (Model.Shifts.Any())
                {
                    foreach (var shift in Model.Shifts)
                    {
                        <tr class="hover:bg-slate-50/40 transition-colors min-h-[100px]">
                            <!-- Time Slot Cell -->
                            <td class="px-4 py-6 font-semibold text-center border-r border-slate-200 bg-slate-50/30 w-[12%]">
                                <div class="text-slate-800 font-extrabold text-xs mb-1 truncate">@shift.ShiftName</div>
                                <div class="inline-flex items-center justify-center px-1.5 py-1 bg-slate-100 text-slate-650 text-[11px] font-bold rounded-lg border border-slate-200 whitespace-nowrap">
                                    @shift.StartTime.ToString("HH:mm") - @shift.EndTime.ToString("HH:mm")
                                </div>
                            </td>
                            
                            <!-- 7 Days Grid Cells -->
                            @for (int i = 0; i < 7; i++)
                            {
                                var day = Model.DaysOfWeek[i];
                                var gridKey = $"{day:yyyy-MM-dd}_{shift.StartTime:hh\\:mm}-{shift.EndTime:hh\\:mm}";
                                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                                var cellBgClass = isToday ? "bg-blue-50/20" : "";
                                
                                <td class="px-3 py-4 border-r border-slate-200 align-top w-[12.57%] @cellBgClass">
                                    @if (Model.ScheduleGrid.TryGetValue(gridKey, out var lessons))
                                    {
                                        <div class="flex flex-col gap-3">
                                            @foreach (var lesson in lessons)
                                            {
                                                <div class="p-3 rounded-xl border border-blue-100 bg-blue-50/40 hover:bg-blue-50 transition-all shadow-sm hover:shadow relative group flex flex-col justify-between">
                                                    <div>
                                                        <!-- Class Name & Code -->
                                                        <h4 class="font-extrabold text-blue-900 text-[13px] leading-tight mb-1 truncate" title="@lesson.ClassCode - @lesson.ClassName">
                                                            @lesson.ClassCode - @lesson.ClassName
                                                        </h4>
                                                        
                                                        <!-- Course Name -->
                                                        <p class="text-slate-550 text-[11px] font-bold mb-2 truncate" title="@lesson.CourseName">@lesson.CourseName</p>
                                                        
                                                        <!-- Time & Room Details -->
                                                        <div class="space-y-1 text-[11px] text-slate-600 font-medium mb-3">
                                                            <div class="flex items-center truncate">
                                                                <svg class="w-3.5 h-3.5 mr-1 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"></path></svg>
                                                                Phòng: <span class="font-bold ml-1 text-slate-800 truncate">@lesson.Room</span>
                                                            </div>
                                                            <div class="flex items-center whitespace-nowrap">
                                                                <svg class="w-3.5 h-3.5 mr-1 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                                                @lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Footer inside Box -->
                                                    <div class="border-t border-blue-100/60 pt-2 mt-2 flex flex-col gap-2">
                                                        <div class="flex justify-between items-center">
                                                            <div></div> <!-- Spacing spacer -->

                                                            <!-- Attendance Status Badge -->
                                                            @if (lesson.IsAttended)
                                                            {
                                                                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[9px] font-extrabold rounded border border-emerald-250 uppercase tracking-wide">
                                                                    Attended
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="px-2 py-0.5 bg-rose-100 text-rose-700 text-[9px] font-extrabold rounded border border-rose-250 uppercase tracking-wide">
                                                                    Not Yet
                                                                </span>
                                                            }
                                                        </div>

                                                        <!-- Action button -->
                                                        <a href="/Teacher/Attendance?classId=@lesson.ClassId&lessonId=@lesson.LessonId"
                                                           class="w-full text-center py-1 px-2 bg-white hover:bg-blue-500 hover:text-white text-blue-650 border border-blue-200 hover:border-blue-500 text-[11px] font-bold rounded-lg transition-all shadow-sm flex items-center justify-center gap-1 mt-1">
                                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2H9a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                                                            Điểm danh
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-slate-350 text-center py-4 font-bold text-xs">-</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-16">
                            <div class="flex flex-col items-center justify-center text-slate-400">
                                <svg class="w-12 h-12 mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                <p class="text-base font-bold">Không tìm thấy ca học nào của trung tâm.</p>
                                <p class="text-xs text-slate-400 mt-1">Vui lòng kiểm tra lại cấu hình ca học hoặc liên hệ Quản lý.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
