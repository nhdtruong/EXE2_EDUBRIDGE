@page
@model EduBridge.Pages.Teacher.LecturesModel
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Quản lý bài giảng";
    ViewData["ActivePage"] = "Lectures";
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
            "Scheduled" => "bg-amber-100 text-amber-800 border border-amber-200",
            "Cancelled" => "bg-rose-100 text-rose-800 border border-rose-200",
            "Rescheduled" => "bg-blue-100 text-blue-800 border border-blue-200",
            _ => "bg-slate-100 text-slate-800 border border-slate-200"
        };
    }

    public string GetStatusText(string status)
    {
        return status switch
        {
            "Completed" => "Hoàn thành",
            "Scheduled" => "Lên lịch",
            "Cancelled" => "Đã hủy",
            "Rescheduled" => "Thay đổi lịch",
            _ => status
        };
    }
}

<!-- Welcome Header -->
<div class="mb-6 p-6 rounded-3xl bg-gradient-to-br from-white to-blue-50 border border-slate-200/80 shadow-sm">
    <div>
        <h1 class="text-2xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-blue-700">Quản lý bài giảng</h1>
        <p class="text-slate-500 mt-1 text-sm font-medium">Ghi chú nội dung giảng dạy và theo dõi tiến độ bài học của từng lớp</p>
    </div>
</div>

<!-- Progress Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    @if (Model.ClassesProgress.Any())
    {
        foreach (var progress in Model.ClassesProgress)
        {
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/60 hover:shadow-md transition-all">
                <h3 class="text-base font-extrabold text-slate-850 mb-3 truncate">@progress.ClassName</h3>
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tiến độ giảng dạy</span>
                    <span class="text-sm font-bold text-blue-600">@progress.CompletedLessons/@progress.TotalLessons bài</span>
                </div>
                <div class="w-full bg-slate-100 rounded-full h-2 mb-2 overflow-hidden">
                    <div class="bg-blue-500 h-2 rounded-full transition-all duration-500" style="width: @progress.PercentComplete%"></div>
                </div>
                <div class="text-slate-400 text-xs font-semibold">@progress.PercentComplete% hoàn thành</div>
            </div>
        }
    }
    else
    {
        <div class="col-span-full text-center py-12 text-slate-400 bg-white rounded-2xl border border-slate-200/60 shadow-sm font-bold">
            Bạn hiện chưa phụ trách lớp học nào.
        </div>
    }
</div>

<!-- Filter/Search Section for Lectures -->
<div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-5 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Search Input -->
        <div class="relative col-span-1 md:col-span-2">
            <input type="text" id="lectureSearchInput" class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all bg-white" placeholder="Tìm kiếm theo chủ đề, nội dung bài giảng...">
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        
        <!-- Class Filter Dropdown -->
        <div>
            <input type="hidden" id="classFilter" value="" data-filter-value="class" />
            <div class="relative" data-search-dropdown>
                <button type="button" data-dropdown-toggle class="flex h-[38px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-3.5 text-left text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                    <span data-dropdown-label>Lớp học: Tất cả</span>
                    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div data-dropdown-panel class="absolute left-0 top-[calc(100%+4px)] z-40 hidden w-full rounded-xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                    <div class="relative p-2 border-b border-slate-100 bg-slate-50/50">
                        <input type="text" data-dropdown-search class="h-9 w-full rounded-lg border border-slate-200 px-3 pr-8 text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-blue-500 placeholder-slate-400 bg-white" placeholder="Tìm lớp...">
                        <svg class="absolute right-4.5 top-5.5 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <div class="max-h-48 overflow-y-auto">
                        <button type="button" data-dropdown-option data-value="" data-label="Lớp học: Tất cả" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Tất cả</button>
                        @foreach (var progress in Model.ClassesProgress)
                        {
                            <button type="button" data-dropdown-option data-value="@progress.ClassName" data-label="Lớp: @progress.ClassName" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">@progress.ClassName</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Filter Dropdown -->
        <div>
            <input type="hidden" id="statusFilter" value="" data-filter-value="status" />
            <div class="relative" data-search-dropdown>
                <button type="button" data-dropdown-toggle class="flex h-[38px] w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-3.5 text-left text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500">
                    <span data-dropdown-label>Trạng thái: Tất cả</span>
                    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div data-dropdown-panel class="absolute left-0 top-[calc(100%+4px)] z-40 hidden w-full rounded-xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                    <div class="relative p-2 border-b border-slate-100 bg-slate-50/50">
                        <input type="text" data-dropdown-search class="h-9 w-full rounded-lg border border-slate-200 px-3 pr-8 text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-blue-500 placeholder-slate-400 bg-white" placeholder="Tìm trạng thái...">
                        <svg class="absolute right-4.5 top-5.5 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <div class="max-h-48 overflow-y-auto">
                        <button type="button" data-dropdown-option data-value="" data-label="Trạng thái: Tất cả" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Tất cả</button>
                        <button type="button" data-dropdown-option data-value="Completed" data-label="Trạng thái: Hoàn thành" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Hoàn thành</button>
                        <button type="button" data-dropdown-option data-value="Scheduled" data-label="Trạng thái: Lên lịch" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Lên lịch</button>
                        <button type="button" data-dropdown-option data-value="Cancelled" data-label="Trạng thái: Đã hủy" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Đã hủy</button>
                        <button type="button" data-dropdown-option data-value="Rescheduled" data-label="Trạng thái: Thay đổi lịch" class="block w-full px-4 py-2 text-left text-sm font-semibold text-slate-755 hover:bg-blue-50/60 transition-colors">Thay đổi lịch</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="flex justify-end gap-2.5 mt-4">
        <button type="button" id="btnResetFilters" class="px-4 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-650 text-xs font-bold rounded-xl transition-all shadow-sm border border-slate-200 flex items-center justify-center gap-1.5 h-[38px]">
            Làm mới bộ lọc
        </button>
    </div>
</div>

<!-- History Table Section (table-fixed for strict column alignment) -->
<div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden mb-8">
    <div class="p-5 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-base font-extrabold text-slate-800">Lịch sử bài giảng</h3>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-slate-600 text-sm table-fixed min-w-[850px]">
            <thead class="bg-slate-100 border-b border-slate-200 text-slate-800 font-bold uppercase text-[11px] tracking-wider">
                <tr>
                    <th scope="col" class="py-4 px-4 text-center w-[6%] border-r border-slate-200">STT</th>
                    <th scope="col" onclick="sortLectures('DateString')" class="py-4 px-6 text-center w-[14%] border-r border-slate-200 cursor-pointer hover:bg-slate-150 transition-colors select-none">
                        <div class="flex items-center justify-center gap-1">
                            <span class="text-center">Ngày</span>
                            <span id="sort-icon-DateString" class="text-slate-400 font-bold text-[10px]">↕</span>
                        </div>
                    </th>
                    <th scope="col" onclick="sortLectures('ClassName')" class="py-4 px-6 text-center w-[16%] border-r border-slate-200 cursor-pointer hover:bg-slate-150 transition-colors select-none">
                        <div class="flex items-center justify-center gap-1">
                            <span class="text-center">Lớp</span>
                            <span id="sort-icon-ClassName" class="text-slate-400 font-bold text-[10px]">↕</span>
                        </div>
                    </th>
                    <th scope="col" onclick="sortLectures('Topic')" class="py-4 px-6 text-left w-[24%] border-r border-slate-200 cursor-pointer hover:bg-slate-150 transition-colors select-none">
                        <div class="flex items-center justify-between">
                            <span>Chủ đề</span>
                            <span id="sort-icon-Topic" class="text-slate-400 font-bold text-[10px]">↕</span>
                        </div>
                    </th>
                    <th scope="col" class="py-4 px-6 text-left w-[24%] border-r border-slate-200">Ghi chú / Nội dung</th>
                    <th scope="col" onclick="sortLectures('Status')" class="py-4 px-6 text-center w-[12%] border-r border-slate-200 cursor-pointer hover:bg-slate-150 transition-colors select-none">
                        <div class="flex items-center justify-center gap-1">
                            <span class="text-center">Trạng thái</span>
                            <span id="sort-icon-Status" class="text-slate-400 font-bold text-[10px]">↕</span>
                        </div>
                    </th>
                    <th scope="col" class="py-4 px-6 text-center w-[8%]">Thao tác</th>
                </tr>
            </thead>
            <tbody id="lecturesTableBody" class="divide-y divide-slate-100 bg-white font-medium text-slate-800">
                <!-- Nạp động bằng JavaScript -->
            </tbody>
        </table>
    </div>
    <div id="lecturesPagination"></div>
</div>

@section Scripts {
    <script>
        // component search dropdown (Owner style)
        function initSearchDropdowns() {
            document.querySelectorAll('[data-search-dropdown]').forEach(dropdown => {
                const container = dropdown.parentElement;
                const hiddenInput = container.querySelector('[data-filter-value]');
                const toggle = dropdown.querySelector('[data-dropdown-toggle]');
                const panel = dropdown.querySelector('[data-dropdown-panel]');
                const label = dropdown.querySelector('[data-dropdown-label]');
                const searchInput = dropdown.querySelector('[data-dropdown-search]');
                const options = Array.from(dropdown.querySelectorAll('[data-dropdown-option]'));

                function close() {
                    panel.classList.add('hidden');
                }

                function open() {
                    document.querySelectorAll('[data-dropdown-panel]').forEach(item => item.classList.add('hidden'));
                    panel.classList.remove('hidden');
                    if (searchInput) {
                        searchInput.value = '';
                        filterOptions('');
                        searchInput.focus();
                    }
                }

                function filterOptions(keyword) {
                    const normalizedKeyword = keyword.trim().toLowerCase();
                    options.forEach(option => {
                        const text = option.textContent.trim().toLowerCase();
                        const optionLabelText = (option.dataset.label || '').toLowerCase();
                        const visible = !normalizedKeyword ||
                            text.includes(normalizedKeyword) ||
                            optionLabelText.includes(normalizedKeyword);
                        option.classList.toggle('hidden', !visible);
                    });
                }

                toggle.addEventListener('click', event => {
                    event.stopPropagation();
                    if (panel.classList.contains('hidden')) {
                        open();
                    } else {
                        close();
                    }
                });

                if (searchInput) {
                    searchInput.addEventListener('input', () => filterOptions(searchInput.value));
                    searchInput.addEventListener('click', event => event.stopPropagation());
                }

                options.forEach(option => {
                    option.addEventListener('click', () => {
                        hiddenInput.value = option.dataset.value || '';
                        label.textContent = option.dataset.label || option.textContent.trim();
                        close();
                        
                        hiddenInput.dispatchEvent(new Event('change'));
                    });
                });

                document.addEventListener('click', event => {
                    if (!dropdown.contains(event.target)) {
                        close();
                    }
                });
            });
        }

        let rawLecturesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LectureHistories));
        let lectureHistoriesData = (rawLecturesData || []).map(lh => ({
            LessonId: lh.LessonId !== undefined ? lh.LessonId : lh.lessonId,
            ClassId: lh.ClassId !== undefined ? lh.ClassId : lh.classId,
            DateString: lh.DateString !== undefined ? lh.DateString : lh.dateString,
            ClassName: lh.ClassName !== undefined ? lh.ClassName : lh.className,
            Topic: lh.Topic !== undefined ? lh.Topic : lh.topic,
            Content: lh.Content !== undefined ? lh.Content : lh.content,
            Status: lh.Status !== undefined ? lh.Status : lh.status
        }));
        
        let currentPage = 1;
        let pageSize = 10;
        let filteredLectures = [...lectureHistoriesData];
        let sortField = '';
        let sortDirection = 'ASC';

        document.addEventListener("DOMContentLoaded", function() {
            initSearchDropdowns();
            renderLecturesTable();

            // Lọc ô tìm kiếm
            document.getElementById("lectureSearchInput").addEventListener("input", filterLectures);
            
            // Lọc theo Lớp dropdown
            document.getElementById("classFilter").addEventListener("change", filterLectures);

            // Lọc theo Trạng thái dropdown
            document.getElementById("statusFilter").addEventListener("change", filterLectures);

            // Nút Reset
            document.getElementById("btnResetFilters").addEventListener("click", () => {
                document.getElementById("lectureSearchInput").value = '';
                
                const clsInput = document.getElementById("classFilter");
                clsInput.value = '';
                clsInput.parentElement.querySelector('[data-dropdown-label]').textContent = 'Lớp học: Tất cả';

                const statusInput = document.getElementById("statusFilter");
                statusInput.value = '';
                statusInput.parentElement.querySelector('[data-dropdown-label]').textContent = 'Trạng thái: Tất cả';
                
                sortField = '';
                sortDirection = 'ASC';
                updateSortIcons();

                filterLectures();
            });
        });

        function filterLectures() {
            const query = document.getElementById("lectureSearchInput").value.trim().toLowerCase();
            const filterClass = document.getElementById("classFilter").value.trim().toLowerCase();
            const filterStatus = document.getElementById("statusFilter").value.trim().toLowerCase();

            filteredLectures = lectureHistoriesData.filter(lh => {
                const matchQuery = !query || 
                    lh.Topic.toLowerCase().includes(query) || 
                    (lh.Content && lh.Content.toLowerCase().includes(query));

                const matchClass = !filterClass || lh.ClassName.toLowerCase() === filterClass;
                const matchStatus = !filterStatus || lh.Status.toLowerCase() === filterStatus;

                return matchQuery && matchClass && matchStatus;
            });

            if (sortField) {
                applySortLectures();
            }

            currentPage = 1;
            renderLecturesTable();
        }

        function sortLectures(field) {
            if (sortField === field) {
                sortDirection = sortDirection === 'ASC' ? 'DESC' : 'ASC';
            } else {
                sortField = field;
                sortDirection = 'ASC';
            }

            updateSortIcons();
            applySortLectures();
            renderLecturesTable();
        }

        function updateSortIcons() {
            const fields = ['DateString', 'ClassName', 'Topic', 'Status'];
            fields.forEach(f => {
                const iconSpan = document.getElementById(`sort-icon-${f}`);
                if (!iconSpan) return;
                if (f === sortField) {
                    iconSpan.textContent = sortDirection === 'ASC' ? '▲' : '▼';
                    iconSpan.className = 'text-blue-600 font-extrabold text-[10px]';
                } else {
                    iconSpan.textContent = '↕';
                    iconSpan.className = 'text-slate-400 font-bold text-[10px]';
                }
            });
        }

        // Sắp xếp bài giảng
        function applySortLectures() {
            filteredLectures.sort((a, b) => {
                let valA = a[sortField];
                let valB = b[sortField];

                if (valA === null || valA === undefined) valA = '';
                if (valB === null || valB === undefined) valB = '';

                if (sortField === 'DateString') {
                    const partsA = valA.split('/');
                    const partsB = valB.split('/');
                    if (partsA.length === 3 && partsB.length === 3) {
                        const dateA = new Date(partsA[2], partsA[1] - 1, partsA[0]);
                        const dateB = new Date(partsB[2], partsB[1] - 1, partsB[0]);
                        return sortDirection === 'ASC' ? dateA - dateB : dateB - dateA;
                    }
                }

                if (typeof valA === 'string') {
                    return sortDirection === 'ASC' 
                        ? valA.localeCompare(valB) 
                        : valB.localeCompare(valA);
                } else {
                    return sortDirection === 'ASC' 
                        ? valA - valB 
                        : valB - valA;
                }
            });
        }

        function renderLecturesTable() {
            const tbody = document.getElementById("lecturesTableBody");
            const paginationEl = document.getElementById("lecturesPagination");
            if (!tbody) return;

            tbody.innerHTML = "";

            const totalItems = filteredLectures.length;
            const totalPages = Math.ceil(totalItems / pageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const start = (currentPage - 1) * pageSize;
            const end = Math.min(start + pageSize, totalItems);
            const pageItems = filteredLectures.slice(start, end);

            if (pageItems.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-slate-400 font-bold">Không tìm thấy ghi chú bài giảng nào phù hợp.</td></tr>`;
                if (paginationEl) paginationEl.innerHTML = "";
                return;
            }

            pageItems.forEach((lh, index) => {
                const indexGlobal = start + index + 1;
                const tr = document.createElement("tr");
                tr.className = "group hover:bg-slate-50 transition-colors border-b border-gray-200";
                tr.innerHTML = `
                    <td class="py-3.5 px-4 text-center font-bold text-slate-500 border-r border-gray-200">${indexGlobal}</td>
                    <td class="py-3.5 px-6 text-center border-r border-gray-200 text-slate-700 font-semibold">${lh.DateString}</td>
                    <td class="py-3.5 px-6 text-center border-r border-gray-200 truncate">
                        <span class="inline-block px-2 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-lg border border-slate-200 truncate max-w-full" title="${lh.ClassName}">
                            ${lh.ClassName}
                        </span>
                    </td>
                    <td class="py-3.5 px-6 font-bold text-slate-900 border-r border-gray-200 truncate" title="${lh.Topic}">${lh.Topic}</td>
                    <td class="py-3.5 px-6 text-slate-500 font-medium border-r border-gray-200 truncate" title="${lh.Content || ''}">${lh.Content || ''}</td>
                    <td class="py-3.5 px-6 text-center border-r border-gray-200">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-extrabold border uppercase tracking-wide ${getBadgeClass(lh.Status)}">
                            ${getStatusIcon(lh.Status)} ${getStatusText(lh.Status)}
                        </span>
                    </td>
                    <td class="py-3.5 px-6 text-center">
                        <div class="flex items-center justify-center">
                            <a href="/Teacher/Lectures/Edit?lessonId=${lh.LessonId}" class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-blue-500 bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors shadow-sm" title="Sửa ghi chú bài giảng">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                                </svg>
                            </a>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            renderPagination(totalPages, totalItems);
        }

        function getBadgeClass(status) {
            return status === "Completed" ? "bg-emerald-100 text-emerald-800 border-emerald-200" :
                   status === "Scheduled" ? "bg-amber-100 text-amber-800 border-amber-200" :
                   status === "Cancelled" ? "bg-rose-100 text-rose-800 border-rose-200" : 
                   status === "Rescheduled" ? "bg-blue-100 text-blue-800 border-blue-200" : "bg-slate-100 text-slate-800 border-slate-200";
        }

        function getStatusText(status) {
            return status === "Completed" ? "Hoàn thành" : 
                   status === "Scheduled" ? "Lên lịch" : 
                   status === "Cancelled" ? "Đã hủy" : 
                   status === "Rescheduled" ? "Thay đổi lịch" : status;
        }

        function getStatusIcon(status) {
            if (status === "Completed") {
                return `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="mr-1 shrink-0" stroke="currentColor" stroke-width="3.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            } else if (status === "Scheduled") {
                return `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="mr-1 shrink-0" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`;
            } else if (status === "Cancelled") {
                return `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="mr-1 shrink-0" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
            }
            return '';
        }

        // Render Pagination đồng bộ với Owner
        function renderPagination(totalPages, totalItems) {
            const container = document.getElementById("lecturesPagination");
            if (!container) return;

            let html = `<div class="flex flex-wrap items-center justify-center gap-6 border-t border-gray-200 bg-white px-6 py-4 text-sm text-gray-600">`;
            
            // Cụm các trang
            html += `<div class="flex items-center gap-1">`;
            
            // Nút đầu
            html += `<button type="button" class="page-link-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600 ${currentPage === 1 ? 'pointer-events-none opacity-40' : ''}" data-page="1" ${currentPage === 1 ? 'disabled' : ''} title="Trang đầu">&laquo;</button>`;
            // Nút trước
            html += `<button type="button" class="page-link-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600 ${currentPage === 1 ? 'pointer-events-none opacity-40' : ''}" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''} title="Trang trước">&lsaquo;</button>`;

            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }

            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    html += `<button type="button" class="page-link-btn inline-flex h-9 min-w-9 items-center justify-center rounded px-3 font-medium transition-colors bg-blue-100 text-blue-700" data-page="${i}">${i}</button>`;
                } else {
                    html += `<button type="button" class="page-link-btn inline-flex h-9 min-w-9 items-center justify-center rounded px-3 font-medium transition-colors text-gray-600 hover:bg-blue-50 hover:text-blue-600" data-page="${i}">${i}</button>`;
                }
            }

            // Nút sau
            html += `<button type="button" class="page-link-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600 ${currentPage === totalPages || totalPages === 0 ? 'pointer-events-none opacity-40' : ''}" data-page="${currentPage + 1}" ${currentPage === totalPages || totalPages === 0 ? 'disabled' : ''} title="Trang sau">&rsaquo;</button>`;
            // Nút cuối
            html += `<button type="button" class="page-link-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 transition-colors hover:bg-blue-50 hover:text-blue-600 ${currentPage === totalPages || totalPages === 0 ? 'pointer-events-none opacity-40' : ''}" data-page="${totalPages}" ${currentPage === totalPages || totalPages === 0 ? 'disabled' : ''} title="Trang cuối">&raquo;</button>`;
            
            html += `</div>`;

            // Cụm thông tin tổng số & pageSize
            html += `<div class="flex items-center gap-4">`;
            html += `<span>Tổng số: ${totalItems} bản ghi</span>`;
            html += `<select class="page-size-select h-10 rounded border border-blue-400 bg-white px-3 text-sm text-gray-700 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100">
                        <option value="10" ${pageSize === 10 ? 'selected' : ''}>10</option>
                        <option value="20" ${pageSize === 20 ? 'selected' : ''}>20</option>
                        <option value="50" ${pageSize === 50 ? 'selected' : ''}>50</option>
                     </select>`;
            html += `</div>`;
                     
            html += `</div>`;
            
            container.innerHTML = html;

            container.querySelectorAll(".page-link-btn").forEach(link => {
                if(!link.hasAttribute('disabled')){
                    link.addEventListener("click", function(e) {
                        e.preventDefault();
                        currentPage = parseInt(this.getAttribute("data-page"));
                        renderLecturesTable();
                    });
                }
            });

            container.querySelector(".page-size-select").addEventListener("change", function() {
                pageSize = parseInt(this.value);
                currentPage = 1;
                renderLecturesTable();
            });
        }
    </script>
}
